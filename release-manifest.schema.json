{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/menaje/codex-mcp-bridge-for-chatgpt/raw/main/release-manifest.schema.json",
  "title": "Codex MCP Bridge for ChatGPT release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "manifestVersion", "product", "package", "toolchain", "repository", "plugin", "uiResources", "release"],
  "properties": {
    "$schema": {
      "const": "./release-manifest.schema.json"
    },
    "manifestVersion": {
      "const": 2
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "description", "runtimeName"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "runtimeName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 100 }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "binaryName", "license", "files", "keywords"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 214 },
        "binaryName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 100 },
        "license": { "type": "string", "minLength": 1, "maxLength": 50 },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
            "maxLength": 160,
            "not": { "pattern": "(^|/)\\.\\.?($|/)" }
          }
        },
        "keywords": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$", "maxLength": 50 }
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "npm", "codexCli"],
      "properties": {
        "node": { "type": "string", "pattern": "^(?:[2-9][0-9]*)$" },
        "npm": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "codexCli": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$" }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "owner", "name"],
      "properties": {
        "provider": { "const": "github" },
        "owner": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$" },
        "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 100 }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "displayName",
        "shortDescription",
        "longDescription",
        "developerName",
        "category",
        "capabilities",
        "defaultPrompt",
        "app"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "shortDescription": { "type": "string", "minLength": 1, "maxLength": 80 },
        "longDescription": { "type": "string", "minLength": 1, "maxLength": 500 },
        "developerName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "category": { "type": "string", "minLength": 1, "maxLength": 80 },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 }
        },
        "defaultPrompt": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        },
        "app": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "id"],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "maxLength": 64
            },
            "id": {
              "type": "string",
              "pattern": "^plugin_asdk_app_[A-Za-z0-9]+$",
              "maxLength": 128
            }
          }
        }
      }
    },
    "uiResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "hashAlgorithm", "hashLength", "minimumContractGeneration", "resources"],
      "properties": {
        "strategy": { "const": "content-hash" },
        "hashAlgorithm": { "const": "sha256" },
        "hashLength": { "type": "integer", "minimum": 12, "maximum": 64 },
        "minimumContractGeneration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["settings", "activity", "dashboard"],
          "properties": {
            "settings": { "type": "integer", "minimum": 1 },
            "activity": { "type": "integer", "minimum": 1 },
            "dashboard": { "type": "integer", "minimum": 1 }
          }
        },
        "resources": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["settings", "activity", "dashboard"] },
          "allOf": [
            { "contains": { "const": "settings" } },
            { "contains": { "const": "activity" } },
            { "contains": { "const": "dashboard" } }
          ]
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tagPrefix", "channel", "generateNotes", "targets", "assets"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
        },
        "tagPrefix": { "type": "string", "pattern": "^[A-Za-z0-9._-]{0,16}$" },
        "channel": { "enum": ["stable", "prerelease"] },
        "generateNotes": { "type": "boolean" },
        "targets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["macos", "windows"],
          "properties": {
            "macos": {
              "type": "object",
              "additionalProperties": false,
              "required": ["architecture", "format", "minimumVersion", "signing", "notarization"],
              "properties": {
                "architecture": { "const": "arm64" },
                "format": { "const": "dmg" },
                "minimumVersion": { "const": "13.0" },
                "signing": { "const": "ad-hoc" },
                "notarization": { "const": "none" }
              }
            },
            "windows": {
              "type": "object",
              "additionalProperties": false,
              "required": ["architecture", "format", "transport", "runtime"],
              "properties": {
                "architecture": { "const": "x64" },
                "format": { "const": "zip" },
                "transport": { "const": "http" },
                "runtime": { "const": "node" }
              }
            }
          }
        },
        "assets": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "npm-tarball",
              "npm-sha256",
              "skills-archive",
              "macos-app",
              "windows-server",
              "release-checksums"
            ]
          },
          "allOf": [
            { "contains": { "const": "npm-tarball" } },
            { "contains": { "const": "npm-sha256" } },
            { "contains": { "const": "skills-archive" } },
            { "contains": { "const": "macos-app" } },
            { "contains": { "const": "windows-server" } },
            { "contains": { "const": "release-checksums" } }
          ]
        }
      }
    }
  }
}
