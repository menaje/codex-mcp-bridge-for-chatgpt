    "공용 인터넷 포트를 자동으로 열지 않습니다. 신뢰하는 LAN 또는 개인 VPN에서 접근할 HTTPS 주소를 지정하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No public internet port is opened automatically. Specify an HTTPS address reachable through a trusted LAN or private VPN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開インターネットポートは自動では開きません。信頼できるLANまたはプライベートVPNからアクセス可能なHTTPSアドレスを指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会自动开放公共互联网端口。请指定可通过可信局域网或专用 VPN 访问的 HTTPS 地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會自動開放公共網際網路埠。請指定可透過可信區域網路或專用 VPN 存取的 HTTPS 地址。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se abre automáticamente ningún puerto público de Internet. Indique una dirección HTTPS accesible desde una LAN de confianza o una VPN privada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun port Internet public n’est ouvert automatiquement. Indiquez une adresse HTTPS accessible depuis un réseau local de confiance ou un VPN privé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nicht automatisch ein öffentlicher Internet-Port geöffnet. Geben Sie eine HTTPS-Adresse an, die über ein vertrauenswürdiges LAN oder privates VPN erreichbar ist."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma porta pública da Internet é aberta automaticamente. Informe um endereço HTTPS acessível por uma LAN confiável ou VPN privada."
          }
        }
      }
    },
    "기기 자격 증명은 macOS Keychain에만 저장됩니다. 서버 주소나 프로필에는 비밀값이 포함되지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device credentials are stored only in the macOS Keychain. Server addresses and profiles contain no secrets."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの資格情報はmacOSキーチェーンにのみ保存されます。サーバーアドレスやプロファイルに秘密情報は含まれません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备凭据仅存储在 macOS 钥匙串中。服务器地址和配置文件不包含任何密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置憑證僅儲存在 macOS 鑰匙串中。伺服器地址和設定檔不包含任何金鑰。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las credenciales del dispositivo solo se guardan en el Llavero de macOS. Las direcciones y los perfiles de servidor no contienen secretos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les identifiants de l’appareil sont stockés uniquement dans le Trousseau macOS. Les adresses et profils de serveur ne contiennent aucun secret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräteanmeldedaten werden ausschließlich im macOS-Schlüsselbund gespeichert. Serveradressen und Profile enthalten keine Geheimnisse."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As credenciais do dispositivo são armazenadas apenas nas Chaves do macOS. Os endereços e perfis de servidor não contêm segredos."
          }
        }
      }
    },
    "기기 페어링": {
      "localizations": {
