    "원격 관리 서버를 시작할 권한이 없습니다. 주소와 포트를 확인해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote management server cannot start with the current permissions. Check the address and port."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の権限ではリモート管理サーバーを起動できません。アドレスとポートを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前权限无法启动远程管理服务器。请检查地址和端口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前權限無法啟動遠端管理伺服器。請檢查位址與連接埠。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de administración remota no puede iniciarse con los permisos actuales. Compruebe la dirección y el puerto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur de gestion à distance ne peut pas démarrer avec les autorisations actuelles. Vérifiez l’adresse et le port."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Remoteverwaltungsserver kann mit den aktuellen Berechtigungen nicht gestartet werden. Prüfen Sie Adresse und Port."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor de gerenciamento remoto não pode iniciar com as permissões atuais. Verifique o endereço e a porta."
          }
        }
      }
    },
    "원격 관리용 보안 인증서를 준비하지 못했습니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The security certificate for remote management could not be prepared."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモート管理用のセキュリティ証明書を準備できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法准备远程管理所需的安全证书。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法準備遠端管理所需的安全憑證。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo preparar el certificado de seguridad para la administración remota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat de sécurité pour la gestion à distance n’a pas pu être préparé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Sicherheitszertifikat für die Remoteverwaltung konnte nicht vorbereitet werden."
          }
        },
        "pt": {
