          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A impressão digital do certificado do servidor é inválida."
          }
        }
      }
    },
    "서버 인증서가 페어링할 때 확인한 인증서와 다릅니다. 연결을 거부했습니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server certificate differs from the one verified during pairing. The connection was refused."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー証明書がペアリング時に確認した証明書と異なるため、接続を拒否しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器证书与配对时验证的证书不同。已拒绝连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器憑證與配對時驗證的憑證不同。已拒絕連線。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El certificado del servidor no coincide con el verificado durante el emparejamiento. Se rechazó la conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat du serveur diffère de celui vérifié lors du jumelage. La connexion a été refusée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Serverzertifikat weicht von dem bei der Kopplung geprüften Zertifikat ab. Die Verbindung wurde abgelehnt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O certificado do servidor é diferente do verificado durante o pareamento. A conexão foi recusada."
          }
        }
      }
    },
    "응답한 서버의 고유 ID가 저장된 서버와 다릅니다. 연결을 거부했습니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The responding server ID differs from the saved server. The connection was refused."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "応答したサーバーのIDが保存済みサーバーと異なるため、接続を拒否しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "响应服务器的 ID 与已保存的服务器不同。已拒绝连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回應伺服器的 ID 與已儲存的伺服器不同。已拒絕連線。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ID del servidor que respondió no coincide con el servidor guardado. Se rechazó la conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identifiant du serveur qui a répondu diffère de celui enregistré. La connexion a été refusée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ID des antwortenden Servers stimmt nicht mit dem gespeicherten Server überein. Die Verbindung wurde abgelehnt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ID do servidor que respondeu é diferente do servidor salvo. A conexão foi recusada."
          }
        }
      }
    },
    "이 앱과 서버의 원격 관리 프로토콜 버전이 호환되지 않습니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote management protocol versions of this app and the server are incompatible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリとサーバーのリモート管理プロトコルのバージョンには互換性がありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用与服务器的远程管理协议版本不兼容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此應用程式與伺服器的遠端管理通訊協定版本不相容。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las versiones del protocolo de gestión remota de esta aplicación y del servidor no son compatibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les versions du protocole de gestion à distance de cette application et du serveur sont incompatibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Versionen des Fernverwaltungsprotokolls dieser App und des Servers sind nicht kompatibel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As versões do protocolo de gerenciamento remoto deste aplicativo e do servidor são incompatíveis."
          }
        }
      }
    },
    "이 서버의 기기 자격 증명을 찾을 수 없어 다시 페어링해야 합니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device credential for this server could not be found. Pair the server again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーのデバイス資格情報が見つかりません。もう一度ペアリングしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到此服务器的设备凭据。请重新配对服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到此伺服器的裝置憑證。請重新配對伺服器。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró la credencial de dispositivo de este servidor. Vuelve a emparejarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’identifiant d’appareil de ce serveur est introuvable. Jumelez à nouveau le serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geräteanmeldedaten für diesen Server wurden nicht gefunden. Koppeln Sie den Server erneut."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A credencial de dispositivo deste servidor não foi encontrada. Pareie o servidor novamente."
          }
        }
      }
    },
    "서버가 이 기기의 자격 증명을 거부했습니다. 서버에서 기기 등록을 확인해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server rejected this device’s credential. Check the device registration on the server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがこのデバイスの資格情報を拒否しました。サーバーでデバイス登録を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝了此设备的凭据。请检查服务器上的设备注册。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器拒絕了此裝置的憑證。請檢查伺服器上的裝置註冊。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor rechazó la credencial de este dispositivo. Comprueba el registro del dispositivo en el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a refusé l’identifiant de cet appareil. Vérifiez l’enregistrement de l’appareil sur le serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat die Anmeldedaten dieses Geräts abgelehnt. Prüfen Sie die Geräteregistrierung auf dem Server."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor rejeitou a credencial deste dispositivo. Verifique o registro do dispositivo no servidor."
          }
        }
      }
    },
    "이 기기에는 요청한 서버 기능을 사용할 권한이 없습니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device is not authorized to use the requested server capability."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスには、要求されたサーバー機能を使用する権限がありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备无权使用请求的服务器功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置無權使用要求的伺服器功能。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene autorización para usar la función solicitada del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’est pas autorisé à utiliser la fonctionnalité demandée du serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät ist nicht berechtigt, die angeforderte Serverfunktion zu verwenden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não tem autorização para usar o recurso solicitado do servidor."
          }
        }
      }
    },
    "원격 서버 응답이 허용 크기를 초과했습니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The remote server response exceeded the allowed size."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートサーバーの応答が許容サイズを超えました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程服务器响应超出了允许的大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端伺服器回應超過允許的大小。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta del servidor remoto superó el tamaño permitido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse du serveur distant dépasse la taille autorisée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort des Remote-Servers hat die zulässige Größe überschritten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta do servidor remoto excedeu o tamanho permitido."
          }
        }
      }
    },
    "원격 서버 응답을 읽을 수 없습니다: %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read the remote server response: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートサーバーの応答を読み取れませんでした：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取远程服务器响应：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取遠端伺服器回應：%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la respuesta del servidor remoto: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la réponse du serveur distant : %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
