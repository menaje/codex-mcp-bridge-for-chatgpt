    "problem.historyOptional": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished failures are kept as history. Reviewing them is optional and preserves the original outcome."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료된 실패는 기록으로 보관됩니다. 확인 처리는 선택 사항이며 원래 결과는 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了した失敗は履歴として保持します。確認は任意で、元の結果は変わりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已结束的失败会保留为历史记录。查看标记为可选操作，原始结果不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已結束的失敗會保留為歷史記錄。查看標記為可選操作，原始結果不變。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fallos finalizados se conservan como historial. Revisarlos es opcional y mantiene el resultado original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les échecs terminés sont conservés dans l’historique. Leur vérification est facultative et conserve le résultat initial."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendete Fehler bleiben im Verlauf. Die Bestätigung ist optional und ändert das ursprüngliche Ergebnis nicht."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As falhas terminadas ficam no histórico. A revisão é opcional e mantém o resultado original."
          }
        }
      }
    },
    "problem.autoNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bridge checks and recovers safe cases automatically, with at most three attempts per action. Unresolved execution issues stay here."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브리지가 안전하게 처리할 수 있는 상황을 자동 점검·복구하며, 같은 조치는 최대 3회 시도합니다. 해결되지 않은 실행 문제만 여기에 남습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブリッジが安全に処理できる状態を自動確認・復旧し、同じ処理への試行は最大3回です。未解決の実行上の問題だけをここに表示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桥接器会自动检查并恢复可安全处理的情况，每项操作最多尝试3次。此处仅保留未解决的执行问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "橋接器會自動檢查並復原可安全處理的情況，每項操作最多嘗試3次。此處僅保留未解決的執行問題。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puente comprueba y recupera los casos seguros automáticamente, hasta tres veces por acción. Aquí quedan los problemas de ejecución sin resolver."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pont vérifie et récupère automatiquement les cas sûrs, avec au plus trois tentatives par action. Les problèmes d’exécution non résolus restent ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bridge prüft und behebt sichere Fälle automatisch, höchstens dreimal pro Maßnahme. Hier bleiben ungelöste Ausführungsprobleme."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A ponte verifica e recupera os casos seguros automaticamente, até três tentativas por ação. Aqui ficam os problemas de execução não resolvidos."
          }
        }
      }
    },
