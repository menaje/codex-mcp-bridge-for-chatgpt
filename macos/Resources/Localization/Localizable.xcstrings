    "macos.theconnectionfileorfolderisnotowned": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindungsdatei oder der Ordner gehört nicht dem aktuellen Benutzer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection file or folder is not owned by the current user."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo o la carpeta de conexión no pertenece al usuario actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier ou dossier de connexion n’appartient pas à l’utilisateur actuel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続情報のファイルまたはフォルダは現在のユーザーが所有していません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo ou a pasta de conexão não pertence ao usuário atual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接信息文件或文件夹不属于当前用户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線資訊檔案或資料夾不屬於目前使用者。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 정보 파일 또는 폴더를 현재 사용자가 소유하지 않습니다."
          }
        }
      }
    },
    "macos.theconnectionfileorfolderpermissionsaretoo": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berechtigungen der Verbindungsdatei oder des Ordners sind zu weit gefasst. Beschränken Sie sie auf den Zugriff durch die App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection file or folder permissions are too broad. Restrict them to app-only access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los permisos del archivo o la carpeta de conexión son demasiado amplios. Limítelos al acceso exclusivo de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autorisations du fichier ou dossier de connexion sont trop larges. Limitez-les à l’accès de l’app uniquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続情報のファイルまたはフォルダのアクセス権限が広すぎます。アプリ専用に制限してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As permissões do arquivo ou da pasta de conexão são muito amplas. Restrinja-as ao acesso exclusivo do aplicativo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接信息文件或文件夹的权限范围过宽。请将其限制为仅供应用访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線資訊檔案或資料夾的權限範圍過寬。請將其限制為僅供應用存取。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 정보 파일 또는 폴더의 접근 권한이 너무 넓습니다. 앱 전용 권한으로 제한해 주세요."
          }
        }
      }
    },
