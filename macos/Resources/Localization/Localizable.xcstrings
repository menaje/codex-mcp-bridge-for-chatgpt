    "dashboard.scopeNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversations currently known to this personal bridge through retained Jobs, Agents, or threads; not all ChatGPT history."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 개인 브리지가 보존 중인 작업·에이전트·스레드로 파악한 대화만 표시합니다. 전체 ChatGPT 기록은 아닙니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この個人用ブリッジが保持しているジョブ、Agent、スレッドから把握できる会話のみを表示します。ChatGPT の全履歴ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示此个人桥接通过保留的任务、Agent 或线程当前已知的对话，并非全部 ChatGPT 历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅顯示此個人橋接透過保留的工作、Agent 或執行緒目前已知的對話，並非所有 ChatGPT 歷史記錄。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversaciones que este puente personal conoce actualmente mediante tareas, Agents o hilos conservados; no es todo el historial de ChatGPT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversations actuellement connues de ce pont personnel grâce aux tâches, Agents ou fils conservés ; il ne s’agit pas de tout l’historique ChatGPT."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterhaltungen, die dieser persönliche Bridge derzeit durch gespeicherte Aufgaben, Agents oder Threads kennt; nicht der gesamte ChatGPT-Verlauf."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversas que esta ponte pessoal conhece no momento por meio de tarefas, Agents ou threads mantidos; não é todo o histórico do ChatGPT."
          }
        }
      }
    },
    "dashboard.runtimeOnly": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status comes only from Codex runtime evidence. Recent App Server process state uses bounded read-only probes; refresh is not a live health check of every historical thread. GPT verification and completion judgment are excluded."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상태는 Codex 런타임 근거만으로 계산합니다. 최근 App Server 프로세스는 제한된 읽기 전용 조회로 확인하며, 새로고침은 모든 과거 스레드의 실시간 상태 검사가 아닙니다. GPT의 검증·완료 판단은 사용하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "状態は Codex ランタイムの根拠だけから算出されます。最近の App Server プロセス状態は範囲を限定した読み取り専用プローブで確認され、更新は過去の全スレッドのライブ正常性チェックではありません。GPT による検証や完了判断は含まれません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态仅依据 Codex 运行时证据计算。近期 App Server 进程状态通过有界只读探测获取；刷新并不是对所有历史线程的实时健康检查。不会使用 GPT 的验证或完成判断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "狀態僅依據 Codex 執行階段證據計算。近期 App Server 程序狀態透過有界唯讀探測取得；重新整理並不是對所有歷史執行緒的即時健康檢查。不會使用 GPT 的驗證或完成判斷。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado se obtiene únicamente de pruebas del entorno de ejecución de Codex. El estado reciente de procesos de App Server usa consultas de solo lectura limitadas; actualizar no comprueba en vivo la salud de todos los hilos históricos. Se excluyen la verificación y el criterio de finalización de GPT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’état repose uniquement sur des preuves de l’environnement d’exécution Codex. L’état récent des processus App Server utilise des sondes bornées en lecture seule ; l’actualisation ne vérifie pas en direct l’intégrité de tous les fils historiques. La vérification et le jugement de fin de GPT sont exclus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Status beruht ausschließlich auf Nachweisen der Codex-Laufzeit. Der aktuelle App-Server-Prozessstatus wird mit begrenzten schreibgeschützten Abfragen ermittelt; eine Aktualisierung ist keine Live-Zustandsprüfung aller historischen Threads. GPT-Prüfung und Abschlussbeurteilung sind ausgeschlossen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O status usa apenas evidências do ambiente de execução do Codex. O estado recente dos processos do App Server usa consultas limitadas e somente leitura; atualizar não é uma verificação ao vivo da integridade de todos os threads históricos. A verificação e o julgamento de conclusão do GPT são excluídos."
          }
        }
      }
    },
