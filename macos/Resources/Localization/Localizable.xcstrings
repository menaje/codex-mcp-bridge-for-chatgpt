    "서버 주소는 경로가 없는 HTTPS 주소여야 합니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server address must be an HTTPS address without a path."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーアドレスには、パスを含まないHTTPSアドレスを指定してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器地址必须是不含路径的 HTTPS 地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
