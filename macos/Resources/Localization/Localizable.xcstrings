          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法停止所有相关进程"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法停止所有相關程序"
          }
        },
        "es": {
