    "dashboard.activeTruncated": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some active or recovery rows are omitted from this bounded view."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 또는 복구가 필요한 일부 행은 제한된 화면에서 생략되었습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "稼働中または復旧が必要な一部の行は、この制限付き表示では省略されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此有界视图省略了部分活跃或恢复状态行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此有界檢視省略了部分使用中或復原狀態列。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omiten algunas filas activas o de recuperación en esta vista limitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines lignes actives ou de récupération sont omises de cette vue bornée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige aktive oder wiederherzustellende Zeilen fehlen in dieser begrenzten Ansicht."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas linhas ativas ou de recuperação foram omitidas desta visualização limitada."
          }
        }
      }
    },
    "dashboard.runtimeUnknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runtime or process state was unavailable for {count} agents."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 {count}개의 런타임 또는 프로세스 상태를 확인하지 못했습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} 件の Agent でランタイムまたはプロセス状態を確認できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取 {count} 个 Agent 的运行时或进程状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法取得 {count} 個 Agent 的執行階段或程序狀態。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener el estado del entorno o del proceso de {count} Agents."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’état de l’environnement ou du processus était indisponible pour {count} Agents."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Laufzeit- oder Prozessstatus war für {count} Agents nicht verfügbar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O status do ambiente ou do processo não estava disponível para {count} Agents."
          }
        }
      }
    },
    "dashboard.runtimeProbeSkipped": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} App Server agents were not probed because a safe non-loading probe was unavailable or the bounded limit was reached."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스레드를 깨우지 않는 안전한 조회가 불가능하거나 조회 한도를 넘은 App Server 에이전트 {count}개는 프로세스 상태를 확인하지 않았습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全な非読み込みプローブを利用できないか上限に達したため、{count} 件の App Server Agent はプローブされませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于没有安全且不会加载线程的探测方式，或已达到有界上限，未探测 {count} 个 App Server Agent。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "因沒有安全且不會載入執行緒的探測方式，或已達有界上限，未探測 {count} 個 App Server Agent。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se consultaron {count} Agents de App Server porque no había una consulta segura que no cargara el hilo o porque se alcanzó el límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} Agents App Server n’ont pas été sondés, faute de sonde sûre ne chargeant pas le fil ou parce que la limite a été atteinte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} App-Server-Agents wurden nicht abgefragt, weil keine sichere, nicht ladende Abfrage verfügbar war oder die Grenze erreicht wurde."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} Agents do App Server não foram consultados porque não havia uma consulta segura que não carregasse a thread ou porque o limite foi atingido."
          }
        }
      }
    },
