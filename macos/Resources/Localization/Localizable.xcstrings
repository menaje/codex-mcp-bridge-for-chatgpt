        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente de la libération des connexions des autres conversations et de Codex."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Unterhaltungen und Codex müssen ihre Verbindungen erst freigeben."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A aguardar que as outras conversas e o Codex libertem as ligações."
          }
        }
      }
    },
    "대화 저장을 확인할 수 없어 연결을 유지합니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화 저장을 확인할 수 없어 연결을 유지합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping the connection because conversation storage could not be verified."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話の保存を確認できないため、接続を維持しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认对话已保存，因此保持连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認對話已儲存，因此保持連線。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mantiene la conexión porque no se pudo verificar que la conversación esté guardada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion est maintenue car l’enregistrement de la conversation n’a pas pu être vérifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung bleibt bestehen, da die Speicherung der Unterhaltung nicht bestätigt werden konnte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A ligação é mantida porque não foi possível confirmar que a conversa foi guardada."
          }
        }
      }
    },
    "백그라운드 작업 종료를 확인한 뒤 인계합니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 작업 종료를 확인한 뒤 인계합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handoff will proceed after background work is confirmed finished."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンド作業の終了を確認してから引き継ぎます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认后台任务已结束后进行交接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認背景工作已結束後進行交接。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia continuará cuando se confirme que el trabajo en segundo plano ha terminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert aura lieu après confirmation de la fin du travail en arrière-plan."
          }
        },
