    "%@까지 1회만 사용할 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usable once until %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@まで1回のみ使用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在%@之前仅可使用一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在%@之前僅可使用一次。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se puede usar una sola vez hasta %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisable une seule fois jusqu’au %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bis %@ einmal verwendbar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode ser usado uma única vez até %@."
          }
        }
      }
    },
