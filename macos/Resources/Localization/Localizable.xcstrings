    "안전하게 종료하지 못했습니다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could Not Quit Safely"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全に終了できませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全退出"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法安全退出"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cerrar de forma segura"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de fermer en toute sécurité"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicheres Beenden nicht möglich"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível encerrar com segurança"
          }
        }
      }
    },
    "실행 중인 작업과 백그라운드 프로세스를 중단하고 앱의 관련 프로세스를 강제로 종료할까요? 파일 변경은 되돌아가지 않습니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrupt running work and background processes and force-quit all app-related processes? Filesystem changes are not rolled back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のタスクとバックグラウンドプロセスを中断し、アプリの関連プロセスを強制終了しますか？ファイルの変更は元に戻りません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要中断正在运行的任务和后台进程，并强制退出应用的所有相关进程吗？文件更改不会回滚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要中斷正在執行的任務和背景程序，並強制退出應用的所有相關程序嗎？檔案更改不會回滾。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Interrumpir las tareas y los procesos en segundo plano activos y forzar el cierre de todos los procesos relacionados con la app? Los cambios en los archivos no se revertirán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompre les tâches et processus en arrière-plan actifs, puis forcer la fermeture de tous les processus associés à l’app ? Les modifications de fichiers ne seront pas annulées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktive Aufgaben und Hintergrundprozesse unterbrechen und alle zugehörigen App-Prozesse zwangsweise beenden? Dateiänderungen werden nicht rückgängig gemacht."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Interromper o trabalho e os processos em segundo plano em execução e forçar o encerramento de todos os processos relacionados ao aplicativo? As alterações no sistema de arquivos não serão desfeitas."
          }
        }
      }
    },
    "관련 프로세스를 모두 종료하지 못했습니다": {
      "extractionState": "manual",
      "localizations": {
        "en": {
