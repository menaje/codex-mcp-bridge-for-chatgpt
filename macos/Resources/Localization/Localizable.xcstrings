            "value": "Wählen Sie, ob dieser Mac den Server ausführt oder eine Verbindung zu einem anderen Server herstellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose whether this Mac runs the server or connects to a server running elsewhere."
          }
        },
        "es": {
