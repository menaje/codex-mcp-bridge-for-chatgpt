    "settings.warning.legacyRoots": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_ROOTS is a legacy compatibility restriction. Remove it to manage project folders only from Codex settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_ROOTS는 이전 버전 호환용 제한입니다. 프로젝트 폴더를 Codex 설정에서만 관리하려면 이 값을 제거하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_ROOTS は旧バージョンとの互換性のための制限です。プロジェクトフォルダーを Codex 設定だけで管理するには削除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_ROOTS 是旧版兼容限制。请将其移除，以便仅通过 Codex 设置管理项目文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_ROOTS 是舊版相容性限制。請移除此設定，以便只透過 Codex 設定管理專案資料夾。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_ROOTS es una restricción de compatibilidad antigua. Elimínala para administrar las carpetas de proyectos solo desde la configuración de Codex."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_ROOTS est une ancienne restriction de compatibilité. Supprimez-la pour gérer les dossiers de projet uniquement dans les paramètres Codex."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_ROOTS ist eine alte Kompatibilitätsbeschränkung. Entfernen Sie sie, um Projektordner ausschließlich in den Codex-Einstellungen zu verwalten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_ROOTS é uma restrição de compatibilidade antiga. Remova-a para gerenciar as pastas dos projetos somente nas configurações do Codex."
          }
        }
      }
    },
    "settings.warning.fastReturnRetired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_FAST_RETURN_MS is retired and ignored. Codex tasks always return after durable asynchronous admission."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_FAST_RETURN_MS는 폐기되어 무시됩니다. Codex 작업은 항상 영속 비동기 접수 후 반환됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_FAST_RETURN_MS は廃止され、無視されます。Codex タスクは常に永続的な非同期受付後に応答します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_FAST_RETURN_MS 已停用并会被忽略。Codex 任务始终在持久异步接收后返回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_FAST_RETURN_MS 已停用並會被忽略。Codex 任務一律在持久非同步接收後傳回。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_FAST_RETURN_MS se retiró y se ignora. Las tareas de Codex siempre responden tras una admisión asíncrona duradera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_FAST_RETURN_MS est retiré et ignoré. Les tâches Codex répondent toujours après une admission asynchrone durable."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_FAST_RETURN_MS wurde eingestellt und wird ignoriert. Codex-Tasks antworten immer nach dauerhafter asynchroner Annahme."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_FAST_RETURN_MS foi descontinuado e é ignorado. As tarefas do Codex sempre respondem após admissão assíncrona durável."
          }
        }
      }
    },
    "settings.warning.upstreamTimeoutRetired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_UPSTREAM_TIMEOUT_MS is retired and ignored. Codex execution has no time limit; use supervised force-stop when needed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_UPSTREAM_TIMEOUT_MS는 폐기되어 무시됩니다. Codex 실행에는 시간 제한이 없으므로 필요할 때 감독하에 강제 종료하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_UPSTREAM_TIMEOUT_MS は廃止され、無視されます。Codex の実行に時間制限はありません。必要な場合は監視下で強制停止してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_UPSTREAM_TIMEOUT_MS 已停用并会被忽略。Codex 执行没有时间限制；需要时请在监督下强制停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_UPSTREAM_TIMEOUT_MS 已停用並會被忽略。Codex 執行沒有時間限制；需要時請在監督下強制停止。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_UPSTREAM_TIMEOUT_MS se retiró y se ignora. La ejecución de Codex no tiene límite de tiempo; usa la detención forzada supervisada cuando sea necesario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_UPSTREAM_TIMEOUT_MS est retiré et ignoré. L’exécution de Codex n’a pas de limite de temps ; utilisez l’arrêt forcé supervisé si nécessaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_UPSTREAM_TIMEOUT_MS wurde eingestellt und wird ignoriert. Die Codex-Ausführung hat kein Zeitlimit; verwenden Sie bei Bedarf einen überwachten Zwangsstopp."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "CODEX_MCP_BRIDGE_UPSTREAM_TIMEOUT_MS foi descontinuado e é ignorado. A execução do Codex não tem limite de tempo; use a interrupção forçada supervisionada quando necessário."
          }
        }
      }
    },
    "settings.warning.defaultSessionRetired": {
      "localizations": {
