    "settings.conflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings changed elsewhere. The latest values were loaded; review them and save again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 곳에서 설정이 변경되었습니다. 최신 값을 불러왔으니 확인한 뒤 다시 저장하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の場所で設定が変更されました。最新の値を確認して、もう一度保存してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置已在其他位置更改。已加载最新值，请检查后再次保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定已在其他位置變更。已載入最新值，請確認後再次儲存。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración cambió en otro lugar. Se cargaron los valores más recientes; revísalos y vuelve a guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres ont changé ailleurs. Les dernières valeurs ont été chargées ; vérifiez-les puis enregistrez à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen wurden an anderer Stelle geändert. Die neuesten Werte wurden geladen; bitte prüfen und erneut speichern."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações foram alteradas em outro local. Os valores mais recentes foram carregados; revise e salve novamente."
