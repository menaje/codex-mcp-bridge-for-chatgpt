    "macos.skills.thisIsALegacyStructuredVersionEditingOrRestoringItCreatesANewFreeFormMarkdownAndFileTreeVersion": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a legacy structured version. Editing or restoring it creates a new free-form Markdown and file-tree version."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 구조형 버전입니다. 수정하거나 복원하면 자유형 Markdown과 파일 트리의 새 버전이 만들어집니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の構造化バージョンです。編集または復元すると、自由形式Markdownとファイルツリーの新しいバージョンが作成されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是旧版结构化版本。编辑或恢复会创建新的自由格式 Markdown 和文件树版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是舊版結構化版本。編輯或還原會建立新的自由格式 Markdown 與檔案樹版本。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una versión estructurada anterior. Al editarla o restaurarla se crea una nueva versión Markdown libre con árbol de archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s’agit d’une ancienne version structurée. Sa modification ou sa restauration crée une nouvelle version Markdown libre avec arborescence de fichiers."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine ältere strukturierte Version. Durch Bearbeiten oder Wiederherstellen entsteht eine neue frei formulierte Markdown-Version mit Dateibaum."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma versão estruturada anterior. Editar ou restaurar cria uma nova versão Markdown de formato livre com árvore de arquivos."
          }
        }
      }
    },
