        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このエージェントが残したバックグラウンドプロセスをすべて停止しますか？ファイル変更は元に戻りません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止此代理留下的所有后台进程？文件更改不会回滚。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要停止此代理程式留下的所有背景程序嗎？檔案變更不會復原。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Detener todos los procesos en segundo plano que dejó este agente? Los cambios en archivos no se revierten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter tous les processus en arrière-plan laissés par cet agent ? Les modifications de fichiers ne sont pas annulées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle von diesem Agenten hinterlassenen Hintergrundprozesse stoppen? Dateiänderungen werden nicht zurückgesetzt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar todos os processos em segundo plano deixados por este agente? As alterações em arquivos não serão revertidas."
          }
        }
      }
    },
