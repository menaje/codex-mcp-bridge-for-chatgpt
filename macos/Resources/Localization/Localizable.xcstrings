        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos valores se guardan en el archivo .env privado existente, no en el Llavero. Al aplicarlos, la app espera de forma segura a que termine el trabajo activo y reinicia el servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces valeurs sont stockées dans le fichier .env privé existant, et non dans le Trousseau. Lors de l’application, l’app attend la fin du travail actif en toute sécurité, puis redémarre le serveur."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの値は既存の非公開.envに保存され、キーチェーンは使用しません。適用時は実行中の作業が安全に完了するのを待ってからサーバーを再起動します。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esses valores são armazenados no arquivo .env privado existente, sem usar as Chaves. Ao aplicá-los, o trabalho em andamento é concluído com segurança antes da reinicialização do servidor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
