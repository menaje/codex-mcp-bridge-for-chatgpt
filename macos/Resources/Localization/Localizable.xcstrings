            "value": "Permitir gerenciamento remoto"
          }
        }
      }
    },
    "원격 모드에서는 이 Mac의 helper나 Codex runtime을 시작하지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote mode does not start the helper or Codex runtime on this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートモードでは、このMacのhelperやCodexランタイムを起動しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程模式不会启动此 Mac 上的 helper 或 Codex 运行时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端模式不會啟動此 Mac 上的 helper 或 Codex 執行時。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo remoto no inicia el helper ni el entorno de ejecución de Codex en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode distant ne démarre ni le helper ni l’environnement d’exécution Codex sur ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Remote-Modus werden der Helper und die Codex-Laufzeit auf diesem Mac nicht gestartet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo remoto não inicia o helper nem o runtime do Codex neste Mac."
          }
        }
      }
    },
    "원격 서버 설정을 불러오지 못했습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not load the remote server settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートサーバー設定を読み込めませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载远程服务器设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入遠端伺服器設定。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar la configuración del servidor remoto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger les paramètres du serveur distant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen des Remote-Servers konnten nicht geladen werden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar as configurações do servidor remoto."
          }
        }
      }
    },
    "원격 클라이언트 모드로 전환할까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to remote client mode?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートクライアントモードに切り替えますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换到远程客户端模式？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換到遠端客戶端模式？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cambiar al modo de cliente remoto?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer en mode client distant ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Remote-Client-Modus wechseln?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternar para o modo de cliente remoto?"
          }
        }
      }
    },
    "이 Mac에만 즉시 적용됩니다. 이 설정을 꺼도 ChatGPT 연결을 위한 브리지 helper와 서버는 백그라운드에서 계속 실행됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies immediately on this Mac. Turning it off does not stop the bridge helper or server used by ChatGPT."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacにのみ直ちに適用されます。この設定をオフにしても、ChatGPT接続用のBridge helperとサーバーはバックグラウンドで動作し続けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅立即应用于此 Mac。关闭此设置后，用于 ChatGPT 连接的 Bridge helper 和服务器仍会在后台运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅立即應用於此 Mac。關閉此設定後，用於 ChatGPT 連線的 Bridge helper 和伺服器仍會在背景執行。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica inmediatamente solo a este Mac. Al desactivarlo, el helper y el servidor Bridge para ChatGPT siguen ejecutándose en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique immédiatement à ce Mac uniquement. Si cette option est désactivée, le helper et le serveur Bridge utilisés par ChatGPT continuent de fonctionner en arrière-plan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt sofort nur für diesen Mac. Auch wenn diese Option deaktiviert ist, werden der Bridge-Helper und der Server für ChatGPT weiterhin im Hintergrund ausgeführt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se imediatamente apenas a este Mac. Desativar esta opção não interrompe o helper nem o servidor Bridge usados pela conexão com o ChatGPT, que continuam em segundo plano."
          }
        }
      }
    },
    "이 Mac에서 서버 실행": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run Server on This Mac"
