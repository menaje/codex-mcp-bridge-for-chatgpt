          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma informação de conexão foi encontrada na área de transferência."
          }
        }
      }
    },
    "페어링 초대를 클립보드에 복사했습니다.": {
