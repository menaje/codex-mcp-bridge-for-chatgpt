            "state": "translated",
            "value": "Los cambios en los archivos no se revertirán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications de fichiers ne seront pas annulées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateiänderungen werden nicht rückgängig gemacht."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações no sistema de arquivos não serão desfeitas."
          }
