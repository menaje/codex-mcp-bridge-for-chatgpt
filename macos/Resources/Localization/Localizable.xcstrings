    "작업과 백그라운드 프로세스를 중단하고 서버를 강제 재시작할까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrupt tasks and background processes and force-restart the server?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクとバックグラウンドプロセスを中断し、サーバーを強制再起動しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中断任务和后台进程并强制重启服务器？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中斷任務和背景程序並強制重啟伺服器？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Interrumpir las tareas y los procesos en segundo plano y forzar el reinicio del servidor?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompre les tâches et processus en arrière-plan, puis forcer le redémarrage du serveur ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben und Hintergrundprozesse unterbrechen und einen Neustart des Servers erzwingen?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Interromper tarefas e processos em segundo plano e forçar a reinicialização do servidor?"
          }
        }
      }
    },
    "작업과 백그라운드 프로세스를 중단하고 서버를 강제 종료할까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrupt tasks and background processes and force-stop the server?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タスクとバックグラウンドプロセスを中断し、サーバーを強制停止しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中断任务和后台进程并强制停止服务器？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中斷任務和背景程序並強制停止伺服器？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Interrumpir las tareas y los procesos en segundo plano y forzar la detención del servidor?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompre les tâches et processus en arrière-plan, puis forcer l’arrêt du serveur ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben und Hintergrundprozesse unterbrechen und das Beenden des Servers erzwingen?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Interromper tarefas e processos em segundo plano e forçar a parada do servidor?"
          }
        }
      }
    },
