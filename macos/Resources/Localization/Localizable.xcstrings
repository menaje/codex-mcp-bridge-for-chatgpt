    "진행 중인 작업이 있으면 완료될 때까지 기다린 뒤 적용합니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei aktiven Aufgaben wartet die App auf deren Abschluss, bevor die Änderung angewendet wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app waits for active work to finish before applying the change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si hay tareas activas, la app espera a que terminen antes de aplicar el cambio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si des tâches sont actives, l’app attend leur achèvement avant d’appliquer la modification."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行中のタスクがある場合は、完了を待ってから適用します。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se houver trabalho em andamento, o aplicativo aguardará a conclusão antes de aplicar a alteração."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果有正在进行的任务，应用会等待其完成后再应用更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果有正在進行的任務，應用會等待其完成後再應用更改。"
          }
        }
      }
    },
    "진행 중인 작업이 제한 시간 안에 끝나지 않아 종료하지 않았습니다. 강제 종료 여부를 확인해 주세요." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die App wurde nicht beendet, da die aktive Arbeit nicht innerhalb des Zeitlimits abgeschlossen wurde. Prüfen Sie, ob Sie das Beenden erzwingen möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app was not quit because active work did not finish before the timeout. Review whether to force quit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app no se cerró porque el trabajo activo no terminó dentro del límite de tiempo. Revise si desea forzar el cierre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app n’a pas été fermée, car le travail actif ne s’est pas terminé dans le délai imparti. Vérifiez si vous souhaitez forcer la fermeture."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "実行中のタスクが制限時間内に完了しなかったため、終了しませんでした。強制終了するか確認してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O aplicativo não foi encerrado porque o trabalho em andamento não terminou antes do limite de tempo. Avalie se deseja forçar o encerramento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于正在进行的任务未在时限内完成，应用未退出。请确认是否强制退出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於正在進行的任務未在時限內完成，應用未退出。請確認是否強制退出。"
          }
        }
      }
    },
