          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambió la lista o el estado de ejecución. Vuelve a seleccionar las entradas actualizadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste ou l’état d’exécution a changé. Sélectionnez à nouveau les éléments actualisés."
