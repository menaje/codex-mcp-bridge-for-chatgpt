    "macos.whenworkcompletesthemenubarappon": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Abschluss sendet die Menüleisten-App auf diesem Mac eine Benachrichtigung. Ein Klick öffnet das Dashboard und fügt der ChatGPT-Unterhaltung nie automatisch eine Nachricht hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When work completes, the menu-bar app on this Mac sends a notification. Clicking it opens Dashboard and never adds an automatic message to the ChatGPT conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al completarse el trabajo, la app de la barra de menús de este Mac envía una notificación. Al hacer clic se abre el panel y nunca se añade un mensaje automático a la conversación de ChatGPT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque le travail est terminé, l’app de barre des menus de ce Mac envoie une notification. Un clic ouvre le tableau de bord et n’ajoute jamais de message automatique à la conversation ChatGPT."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了すると、この Mac のメニューバーアプリが通知を送ります。クリックするとダッシュボードが開き、ChatGPT 会話に自動メッセージを追加しません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando o trabalho é concluído, o app da barra de menus deste Mac envia uma notificação. Ao clicar, o painel é aberto e nenhuma mensagem automática é adicionada à conversa do ChatGPT."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作完成后，此 Mac 的菜单栏应用会发送通知。点击会打开概览，且不会向 ChatGPT 对话添加自动消息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作完成後，此 Mac 的選單列 App 會傳送通知。點按會開啟總覽，且不會在 ChatGPT 對話中新增自動訊息。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료되면 이 Mac의 메뉴 막대 앱이 알림을 보냅니다. 알림을 클릭하면 현황을 열며 ChatGPT 대화에 자동 메시지를 추가하지 않습니다."
          }
        }
      }
    },
