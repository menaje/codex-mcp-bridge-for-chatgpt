            "value": "Vor dem Backend-Wechsel"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de alternar o backend"
          }
        }
      }
    },
    "변경 사항은 서버를 재시작한 뒤 새 에이전트 또는 새로 시작한 에이전트부터 적용됩니다. 기존 에이전트는 생성 당시 백엔드를 계속 사용하며, 다른 백엔드로 새로 시작할 때는 이전 작업을 요약해 전달해야 합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the server restarts, the change applies only to new Agents or Agents deliberately started fresh. Existing Agents stay on their original backend; starting fresh on another backend requires a summary of prior work."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更はサーバー再起動後、新しいAgentまたは新規開始したAgentから適用されます。既存のAgentは作成時のバックエンドを引き続き使用します。別のバックエンドで新規開始する場合は、それまでの作業概要を引き継ぐ必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器重启后，更改仅应用于新代理或重新开始的代理。现有代理继续使用创建时的后端；在其他后端重新开始时，需要提供先前工作的摘要。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器重啟後，更改僅應用於新代理程式或重新開始的代理程式。現有代理程式繼續使用建立時的後端；在其他後端重新開始時，需要提供先前工作的摘要。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras reiniciar el servidor, el cambio solo se aplica a agentes nuevos o reiniciados desde cero. Los agentes existentes mantienen el backend con el que se crearon; al empezar de nuevo con otro backend debe proporcionarse un resumen del trabajo anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après le redémarrage du serveur, la modification ne s’applique qu’aux nouveaux agents ou à ceux relancés avec un nouveau contexte. Les agents existants conservent leur backend d’origine ; un redémarrage sur un autre backend nécessite un résumé du travail précédent."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Serverneustart gilt die Änderung nur für neue oder bewusst neu gestartete Agenten. Vorhandene Agenten behalten ihr ursprüngliches Backend. Bei einem Neustart auf einem anderen Backend muss eine Zusammenfassung der bisherigen Arbeit übergeben werden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Após reiniciar o servidor, a alteração se aplica apenas a agentes novos ou reiniciados com novo contexto. Os agentes existentes mantêm o backend original; para recomeçar em outro backend, é necessário fornecer um resumo do trabalho anterior."
          }
        }
      }
    },
    "변경사항 자동 저장": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes Save Automatically"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を自動保存"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动保存更改"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動儲存更改"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar cambios automáticamente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer automatiquement les modifications"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen automatisch speichern"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar alterações automaticamente"
          }
        }
      }
    },
    "변경사항은 자동으로 저장되어 기존 ChatGPT 카드와 공유됩니다. 프로젝트 등록은 일반 설정 초기화에 포함되지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes save automatically and are shared with existing ChatGPT cards. Project registrations are not reset with general settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は自動保存され、既存のChatGPTカードと共有されます。プロジェクト登録は一般設定のリセット対象に含まれません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改会自动保存并与现有 ChatGPT 卡片共享。项目注册不会随常规设置一起重置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改會自動儲存並與現有 ChatGPT 卡片共享。專案註冊不會隨常規設定一起重置。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se guardan automáticamente y se comparten con las tarjetas de ChatGPT existentes. Los registros de proyectos no se incluyen al restablecer la configuración general."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications sont enregistrées automatiquement et partagées avec les cartes ChatGPT existantes. Les inscriptions de projets ne sont pas réinitialisées avec les paramètres généraux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen werden automatisch gespeichert und mit vorhandenen ChatGPT-Karten geteilt. Projektregistrierungen werden beim Zurücksetzen der allgemeinen Einstellungen nicht zurückgesetzt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações são salvas automaticamente e compartilhadas com os cartões existentes do ChatGPT. Os registros de projetos não são redefinidos com as configurações gerais."
          }
        }
      }
    },
