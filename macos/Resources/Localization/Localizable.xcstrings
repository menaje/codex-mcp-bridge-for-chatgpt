          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Serverprozess läuft, aber die Verbindung konnte nicht bestätigt werden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O processo do servidor está em execução, mas não foi possível confirmar a conexão."
          }
        }
      }
    },
    "브리지 서버의 응답을 확인하지 못했습니다. 잠시 후 다시 확인해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브리지 서버의 응답을 확인하지 못했습니다. 잠시 후 다시 확인해 주세요."
          }
        },
