    "프로젝트 이름과 연결할 기존 폴더를 관리합니다. 앱은 실제 폴더나 파일을 이동하지 않습니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwalten Sie Projektnamen und die verknüpften vorhandenen Ordner. Die App verschiebt keine Ordner oder Dateien."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manage project names and their linked existing folders. The app never moves actual folders or files."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestiona los nombres de los proyectos y las carpetas existentes vinculadas. La app nunca mueve carpetas ni archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gérez les noms des projets et leurs dossiers existants liés. L’app ne déplace jamais les dossiers ni les fichiers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクト名とリンク先の既存フォルダを管理します。アプリが実際のフォルダやファイルを移動することはありません。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerencie os nomes dos projetos e as pastas existentes vinculadas a eles. O aplicativo nunca move pastas ou arquivos reais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理项目名称及其关联的现有文件夹。应用不会移动实际文件夹或文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理專案名稱及其關聯的現有資料夾。應用不會移動實際資料夾或檔案。"
          }
        }
      }
    },
