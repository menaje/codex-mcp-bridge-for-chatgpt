          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a conversa deste agente no aplicativo Codex."
          }
        }
      }
    },
    "Codex 작업을 시작하려면 기존 폴더를 하나 이상 등록하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register at least one existing folder before starting Codex work."
          }
        },
        "ja": {
