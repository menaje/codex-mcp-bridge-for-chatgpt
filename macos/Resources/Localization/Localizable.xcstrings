    "dashboard.scope.runtimeNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Statuses describe Codex execution. Completing a turn does not necessarily complete the overall goal."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상태는 Codex 실행을 기준으로 표시합니다. 한 번의 실행 완료와 전체 목표의 완료는 다를 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "状態は Codex の実行を示します。1 回の実行完了と全体の目標達成は異なる場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态表示 Codex 的执行情况。一次执行完成不一定代表整体目标已完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "狀態表示 Codex 的執行情況。一次執行完成不一定代表整體目標已完成。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los estados describen la ejecución de Codex. Completar un turno no implica completar el objetivo general."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les états décrivent l’exécution de Codex. La fin d’un tour ne signifie pas forcément que l’objectif global est atteint."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Status beschreibt die Codex-Ausführung. Ein abgeschlossener Turn bedeutet nicht unbedingt, dass das Gesamtziel erreicht ist."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os estados descrevem a execução do Codex. Concluir um turno não significa necessariamente concluir o objetivo geral."
          }
        }
      }
    },
