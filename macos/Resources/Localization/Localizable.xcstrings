    "설정 창의 프로젝트 탭에서 첫 작업 폴더를 등록합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register the first work folder in the Projects tab of Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定画面の「プロジェクト」タブで最初の作業フォルダを登録します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置的“项目”标签页中注册第一个工作文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設定的“專案”標籤頁中註冊第一個工作資料夾。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre la primera carpeta de trabajo en la pestaña Proyectos de Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez le premier dossier de travail dans l’onglet Projets des paramètres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrieren Sie den ersten Arbeitsordner im Tab „Projekte“ der Einstellungen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre a primeira pasta de trabalho na aba Projetos das Configurações."
          }
        }
      }
    },
