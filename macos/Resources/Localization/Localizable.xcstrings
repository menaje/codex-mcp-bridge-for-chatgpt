    },
    "settings.warning.legacyProjects": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Legacy project IDs and default aliases were not migrated. Register projects by name in Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 프로젝트 ID와 기본 별칭은 마이그레이션되지 않았습니다. 설정에서 프로젝트를 이름으로 등록하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旧形式のプロジェクト ID と既定の別名は移行されませんでした。設定でプロジェクトを名前から登録してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版项目 ID 和默认别名未迁移。请在设置中按名称注册项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊版專案 ID 與預設別名未遷移。請在設定中依名稱註冊專案。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ID de proyecto y alias predeterminados antiguos no se migraron. Registra los proyectos por nombre en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les anciens identifiants de projet et alias par défaut n’ont pas été migrés. Enregistrez les projets par leur nom dans les paramètres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte Projekt-IDs und Standardaliase wurden nicht migriert. Registrieren Sie Projekte in den Einstellungen nach Namen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "IDs de projeto e aliases padrão antigos não foram migrados. Registre os projetos por nome em Configurações."
          }
        }
      }
    },
    "settings.warning.automaticFallbackSeeded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The automatic model policy had no exact fallback, so the configured model and effort were saved as its fallback when GPT omits a selection."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 모델 정책에 정확한 폴백이 없어, 설정된 모델과 에포트를 GPT가 선택을 생략할 때 사용할 폴백으로 저장했습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動モデルポリシーに正確なフォールバックがなかったため、設定済みのモデルとエフォートを GPT が選択を省略した場合のフォールバックとして保存しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动模型策略缺少确切的回退选项，因此已将配置的模型和推理强度保存为 GPT 未选择时的回退项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動模型政策缺少確切的備援選項，因此已將設定的模型與推理強度儲存為 GPT 未選擇時的備援項目。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La política automática no tenía una alternativa exacta, por lo que se guardaron el modelo y el esfuerzo configurados para cuando GPT omita la selección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La politique automatique n’avait pas de solution de repli exacte ; le modèle et l’effort configurés ont donc été enregistrés pour le cas où GPT omettrait son choix."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der automatischen Modellrichtlinie fehlte eine genaue Ausweichoption. Daher wurden das konfigurierte Modell und die Denkstufe als Ausweichwert gespeichert, falls GPT keine Auswahl trifft."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A política automática não tinha uma alternativa exata; por isso, o modelo e o esforço configurados foram salvos para quando o GPT omitir a seleção."
          }
        }
      }
    },
    "settings.warning.automaticFallbackRemoved": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A retired automatic model default was removed. GPT must now choose an exact model and reasoning effort for new work."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폐기된 자동 모델 기본값을 제거했습니다. 이제 새 작업에는 GPT가 정확한 모델과 추론 수준을 선택해야 합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "廃止された自動モデルの既定値を削除しました。新しい作業では GPT が正確なモデルと推論エフォートを選択する必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除停用的自动模型默认值。现在新任务必须由 GPT 选择准确的模型和推理强度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除停用的自動模型預設值。現在新工作必須由 GPT 選擇精確的模型與推理強度。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminó el valor predeterminado retirado del modelo automático. Ahora GPT debe elegir un modelo y un nivel de razonamiento exactos para el trabajo nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La valeur par défaut retirée du modèle automatique a été supprimée. GPT doit désormais choisir un modèle et un effort de raisonnement exacts pour tout nouveau travail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der eingestellte Standard für die automatische Modellauswahl wurde entfernt. GPT muss für neue Arbeit nun ein exaktes Modell und eine Reasoning-Stufe wählen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O padrão descontinuado do modelo automático foi removido. Agora o GPT deve escolher um modelo e um nível de raciocínio exatos para novos trabalhos."
          }
        }
      }
    },
    "settings.warning.fullAccessDowngraded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved full-access mode is retained but inactive because bridge security policy disables danger-full-access. Read-only is enforced until full access is enabled in runtime settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 전체 접근 모드는 유지되지만 브리지 보안 정책에서 danger-full-access를 허용하지 않아 현재 비활성 상태입니다. 런타임 설정에서 전체 접근을 허용할 때까지 읽기 전용으로 실행됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのフルアクセス設定は維持されますが、ブリッジのセキュリティポリシーで danger-full-access が無効なため現在は適用されません。ランタイム設定でフルアクセスを有効にするまで読み取り専用で実行されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存的完全访问设置会保留，但由于桥接安全策略禁用了 danger-full-access，目前不会生效。在运行时设置中启用完全访问之前，将强制使用只读模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的完整存取設定會保留，但因橋接安全政策停用 danger-full-access，目前不會生效。在執行階段設定中啟用完整存取之前，將強制使用唯讀模式。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de acceso completo guardado se conserva, pero permanece inactivo porque la política de seguridad del puente desactiva danger-full-access. Se aplica solo lectura hasta habilitar el acceso completo en la configuración de ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode d’accès complet enregistré est conservé, mais reste inactif car la politique de sécurité du pont désactive danger-full-access. La lecture seule est imposée jusqu’à l’activation de l’accès complet dans les paramètres d’exécution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gespeicherte Vollzugriffsmodus bleibt erhalten, ist aber inaktiv, da die Sicherheitsrichtlinie der Bridge danger-full-access deaktiviert. Bis Vollzugriff in den Laufzeiteinstellungen aktiviert wird, gilt der schreibgeschützte Modus."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo de acesso total salvo é preservado, mas permanece inativo porque a política de segurança da ponte desativa danger-full-access. O modo somente leitura é aplicado até que o acesso total seja habilitado nas configurações de execução."
          }
        }
      }
    },
    "settings.warning.concurrentLimitReduced": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved concurrent-job limit was reduced to the current bridge maximum."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 동시 작업 수를 현재 브리지의 최댓값으로 줄였습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの同時ジョブ数を、現在のブリッジの上限まで減らしました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将保存的并发任务上限降至当前桥接的最大值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已將儲存的並行工作上限降至目前橋接的最大值。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite de tareas simultáneas guardado se redujo al máximo actual del puente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite de tâches simultanées enregistrée a été réduite au maximum actuel du pont."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherte Grenze gleichzeitiger Aufgaben wurde auf das aktuelle Maximum der Bridge reduziert."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite salvo de tarefas simultâneas foi reduzido ao máximo atual da ponte."
          }
        }
      }
    },
    "settings.warning.projectUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved project “{project}” is unavailable and cannot accept new work."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 프로젝트 ‘{project}’을(를) 사용할 수 없어 새 작업을 받을 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのプロジェクト「{project}」は利用できないため、新しい作業を受け付けられません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的项目“{project}”不可用，无法接收新工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的專案「{project}」無法使用，不能接收新工作。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proyecto guardado «{project}» no está disponible y no puede aceptar trabajo nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet enregistré « {project} » est indisponible et ne peut pas accepter de nouveau travail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gespeicherte Projekt „{project}“ ist nicht verfügbar und kann keine neue Arbeit annehmen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O projeto salvo “{project}” não está disponível e não pode aceitar novos trabalhos."
          }
        }
      }
    },
    "settings.warning.legacyModel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The legacy model-only preference “{model}” is still active. Its exact default effort comes from the backend catalog, while Fast mode remains a separate preference."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 모델 전용 설정 ‘{model}’이(가) 아직 적용 중입니다. 정확한 기본 에포트는 백엔드 카탈로그에서 가져오며 빠른 처리는 별도 설정으로 유지됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旧形式のモデルのみの設定「{model}」が引き続き有効です。正確な既定エフォートはバックエンドカタログから取得され、高速処理 は別の設定として維持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版的仅模型设置“{model}”仍然有效。确切的默认推理强度来自后端目录，快速处理 仍是独立设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊版的僅模型設定「{model}」仍然有效。確切的預設推理強度來自後端目錄，快速處理 仍是獨立設定。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La preferencia antigua de solo modelo «{model}» sigue activa. El esfuerzo predeterminado exacto procede del catálogo del backend y el modo rápido sigue siendo una preferencia independiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ancienne préférence limitée au modèle « {model} » reste active. L’effort exact par défaut provient du catalogue du backend et le mode rapide reste un réglage distinct."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die alte reine Modelleinstellung „{model}“ ist weiterhin aktiv. Die genaue Standard-Denkstufe stammt aus dem Backend-Katalog; Schnellmodus bleibt eine separate Einstellung."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A preferência antiga somente de modelo “{model}” continua ativa. O esforço padrão exato vem do catálogo do backend e o modo rápido continua sendo uma preferência separada."
          }
        }
      }
    },
    "settings.warning.legacyAutomatic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The legacy automatic model policy has no exact saved fallback. The backend catalog default remains in use until a default model and reasoning effort are saved in Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 자동 모델 정책에 저장된 정확한 폴백이 없습니다. 설정에서 기본 모델과 추론 에포트를 저장할 때까지 백엔드 카탈로그 기본값을 사용합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旧形式の自動モデルポリシーには、保存済みの正確なフォールバックがありません。設定で既定のモデルと推論エフォートを保存するまで、バックエンドカタログの既定値を使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版自动模型策略没有已保存的确切回退项。在设置中保存默认模型和推理强度之前，将继续使用后端目录默认值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊版自動模型政策沒有已儲存的確切備援項目。在設定中儲存預設模型與推理強度之前，會繼續使用後端目錄預設值。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La política automática antigua no tiene una alternativa exacta guardada. Se seguirá usando el valor predeterminado del catálogo del backend hasta guardar un modelo y esfuerzo predeterminados en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ancienne politique automatique ne contient pas de solution de repli exacte enregistrée. La valeur par défaut du catalogue du backend reste utilisée jusqu’à l’enregistrement d’un modèle et d’un effort par défaut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die alte automatische Modellrichtlinie hat keine genaue gespeicherte Ausweichoption. Der Standard des Backend-Katalogs bleibt aktiv, bis in den Einstellungen ein Standardmodell und eine Denkstufe gespeichert werden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A política automática antiga não tem uma alternativa exata salva. O padrão do catálogo do backend continuará em uso até que um modelo e esforço padrão sejam salvos em Configurações."
          }
        }
      }
    },
    "settings.warning.modelPolicy": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved model policy is incompatible with the current catalog or constraints. Review it and save a valid selection{codeSuffix}."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 모델 정책이 현재 카탈로그 또는 제약 조건과 맞지 않습니다. 확인한 뒤 유효한 선택을 저장하세요{codeSuffix}."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのモデルポリシーは、現在のカタログまたは制約と互換性がありません。確認して有効な選択を保存してください{codeSuffix}。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存的模型策略与当前目录或约束不兼容。请检查并保存有效选项{codeSuffix}。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存的模型政策與目前目錄或限制不相容。請檢查並儲存有效選項{codeSuffix}。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La política de modelo guardada no es compatible con el catálogo o las restricciones actuales. Revísala y guarda una selección válida{codeSuffix}."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La politique de modèle enregistrée est incompatible avec le catalogue ou les contraintes actuelles. Vérifiez-la et enregistrez une sélection valide{codeSuffix}."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherte Modellrichtlinie ist mit dem aktuellen Katalog oder den Einschränkungen nicht kompatibel. Prüfen Sie sie und speichern Sie eine gültige Auswahl{codeSuffix}."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A política de modelo salva é incompatível com o catálogo ou as restrições atuais. Revise-a e salve uma seleção válida{codeSuffix}."
          }
        }
      }
    },
    "settings.warning.generic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bridge warning requires attention. Review the bridge diagnostics for details."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인이 필요한 브리지 경고가 있습니다. 자세한 내용은 브리지 진단을 확인하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認が必要なブリッジ警告があります。詳細はブリッジの診断情報を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有一条桥接警告需要处理。详情请查看桥接诊断信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有一則橋接警告需要處理。詳細資訊請查看橋接診斷。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una advertencia del puente que requiere atención. Consulta los diagnósticos del puente para obtener detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un avertissement du pont nécessite votre attention. Consultez les diagnostics du pont pour plus de détails."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Bridge-Warnung erfordert Aufmerksamkeit. Weitere Informationen finden Sie in der Bridge-Diagnose."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Há um aviso da ponte que requer atenção. Consulte os diagnósticos da ponte para obter detalhes."
          }
        }
      }
    },
