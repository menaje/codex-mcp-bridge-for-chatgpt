    "끄면 Ultra 추론이 모델 목록에서 제외되고 하위 에이전트 위임이 차단됩니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, Ultra reasoning is removed from model choices and sub-agent delegation is blocked."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、モデル一覧からUltra推論が除外され、サブエージェントへの委任が無効になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，Ultra 推理将从模型列表中移除，并禁止委派给子代理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後，Ultra 推理將從模型列表中移除，並禁止委派給子代理程式。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al desactivarlo, el razonamiento Ultra se elimina de la lista de modelos y se bloquea la delegación a subagentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque cette option est désactivée, le raisonnement Ultra est retiré de la liste des modèles et la délégation aux sous-agents est bloquée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn diese Option deaktiviert ist, wird Ultra-Reasoning aus der Modellliste entfernt und die Delegierung an Unteragenten blockiert."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando desativado, o raciocínio Ultra é removido da lista de modelos e a delegação para subagentes é bloqueada."
          }
        }
      }
    },
    "다른 Mac에서 이 서버 관리": {
