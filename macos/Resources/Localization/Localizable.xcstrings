          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有保留的失敗記錄。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay fallos conservados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun échec conservé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine aufbewahrten Fehler."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há falhas conservadas."
          }
        }
      }
    },
