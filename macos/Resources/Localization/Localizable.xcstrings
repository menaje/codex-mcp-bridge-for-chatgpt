    "30을 넘기면 CPU·메모리·API 사용량이 크게 증가할 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Values above 30 can substantially increase CPU, memory, and API usage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30を超えると、CPU、メモリ、APIの使用量が大幅に増える場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过 30 可能会显著增加 CPU、内存和 API 使用量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超過 30 可能會顯著增加 CPU、記憶體和 API 使用量。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores superiores a 30 pueden aumentar considerablemente el uso de CPU, memoria y API."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une valeur supérieure à 30 peut augmenter considérablement l’utilisation du processeur, de la mémoire et de l’API."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werte über 30 können die CPU-, Arbeitsspeicher- und API-Nutzung erheblich steigern."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores acima de 30 podem aumentar consideravelmente o uso de CPU, memória e API."
          }
        }
      }
    },
    "5분 동안 유효한 새 페어링 초대 만들기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a new pairing invitation valid for 5 minutes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5分間有効な新しいペアリング招待を作成"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建有效期为 5 分钟的新配对邀请"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立有效期為 5 分鐘的新配對邀請"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear una invitación de emparejamiento válida durante 5 minutos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créer une invitation de jumelage valable 5 minutes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Kopplungseinladung mit 5 Minuten Gültigkeit erstellen"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Criar novo convite de pareamento válido por 5 minutos"
          }
        }
