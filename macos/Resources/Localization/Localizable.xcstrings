    "settings.fixedNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This exact selection is enforced for Codex turns admitted after saving. An already active turn keeps its admission-time decision."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 이후 접수되는 Codex turn에는 이 exact selection이 강제됩니다. 이미 실행 중인 turn은 접수 시점 결정을 유지합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存後に受け付けた Codex ターンには、この選択が厳密に適用されます。すでに実行中のターンには、受付時の決定が維持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存后接收的 Codex 轮次将严格使用此选择。已在运行的轮次会保留接收时的决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存後接收的 Codex 輪次會嚴格套用此選擇。已在執行的輪次會保留接收時的決定。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta selección exacta se aplica a los turnos de Codex admitidos después de guardar. Un turno ya activo conserva la decisión tomada al admitirse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sélection exacte s’applique aux tours Codex admis après l’enregistrement. Un tour déjà actif conserve la décision prise lors de son admission."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese genaue Auswahl wird für Codex-Turns erzwungen, die nach dem Speichern angenommen werden. Ein bereits aktiver Turn behält die bei der Annahme getroffene Entscheidung."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta seleção exata é aplicada aos turnos do Codex aceitos após salvar. Um turno já ativo mantém a decisão tomada na admissão."
          }
        }
      }
    },
