    "ChatGPT Developer mode에서 이 Tunnel을 No Auth로 연결합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect this Tunnel with No Auth in ChatGPT Developer mode."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ChatGPTのDeveloper modeで、このTunnelをNo Authとして接続します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 ChatGPT 开发者模式中以 No Auth 方式连接此 Tunnel。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 ChatGPT 開發者模式中以 No Auth 方式連線此 Tunnel。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte este Tunnel con No Auth en el modo de desarrollador de ChatGPT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez ce Tunnel avec l’option No Auth dans le mode développeur de ChatGPT."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie diesen Tunnel im ChatGPT-Entwicklermodus mit „No Auth“."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte este Tunnel sem autenticação no modo de desenvolvedor do ChatGPT."
          }
        }
      }
    },
