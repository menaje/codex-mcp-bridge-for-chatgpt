          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 진행 신호가 없습니다. 프로세스 생존 여부는 알 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
