    "settings.fullWarning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full access runs Codex with this macOS user's filesystem and network permissions. A project folder selects where work starts; it is not OS isolation."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 접근은 이 macOS 사용자의 파일시스템·네트워크 권한으로 Codex를 실행합니다. 프로젝트 폴더는 작업 시작 위치를 정할 뿐 OS 격리가 아닙니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルアクセスでは、この macOS ユーザーのファイルシステム権限とネットワーク権限で Codex が実行されます。プロジェクトフォルダーは開始位置を選ぶだけで、OS レベルの隔離ではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全访问会使用此 macOS 用户的文件系统和网络权限运行 Codex。项目文件夹只决定工作起点，并不提供操作系统隔离。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完整存取會以此 macOS 使用者的檔案系統與網路權限執行 Codex。專案資料夾只決定工作起點，並非作業系統隔離。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso total ejecuta Codex con los permisos de archivos y red de este usuario de macOS. La carpeta del proyecto solo elige dónde empieza el trabajo; no aísla el sistema operativo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès complet exécute Codex avec les autorisations de fichiers et de réseau de cet utilisateur macOS. Le dossier du projet choisit seulement le point de départ du travail ; il n’isole pas le système."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollzugriff führt Codex mit den Datei- und Netzwerkrechten dieses macOS-Benutzers aus. Der Projektordner legt nur den Arbeitsbeginn fest und ist keine Betriebssystem-Isolation."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso total executa o Codex com as permissões de arquivos e rede deste usuário do macOS. A pasta do projeto apenas define onde o trabalho começa; não isola o sistema operacional."
          }
        }
      }
    },
