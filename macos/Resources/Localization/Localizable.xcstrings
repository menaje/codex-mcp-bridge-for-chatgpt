            "state": "translated",
            "value": "No se pudieron actualizar algunos datos. Pueden mostrarse los últimos valores comprobados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains détails n’ont pas pu être actualisés. Les dernières valeurs vérifiées peuvent être affichées."
          }
        },
        "ja": {
          "stringUnit": {
