    "설정을 불러오려면 이 Mac의 브리지 서버를 시작해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the Bridge server on this Mac to load settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を読み込むには、このMacのBridgeサーバーを起動してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请启动此 Mac 上的 Bridge 服务器以加载设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請啟動此 Mac 上的 Bridge 伺服器以載入設定。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie el servidor Bridge en este Mac para cargar la configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez le serveur Bridge sur ce Mac pour charger les paramètres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie den Bridge-Server auf diesem Mac, um die Einstellungen zu laden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie o servidor Bridge neste Mac para carregar as configurações."
          }
        }
      }
    },
    "설정을 불러오지 못했습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings could not be loaded."
