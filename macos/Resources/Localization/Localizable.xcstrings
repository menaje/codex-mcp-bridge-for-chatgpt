          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近没有进度信号；无法确定进程是否仍在运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
