          }
        }
      }
    },
    "problem.auto.unconfirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bridge could not confirm a safe action or its result."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전한 조치 여부나 처리 결과를 확정하지 못했습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全に処理できるか、または処理結果を確認できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认可安全执行的操作或其结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認可安全執行的操作或其結果。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar una acción segura o su resultado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pont n’a pas pu confirmer une action sûre ou son résultat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine sichere Maßnahme oder ihr Ergebnis konnte nicht bestätigt werden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar uma ação segura ou o respetivo resultado."
          }
        }
      }
    },
    "problem.auto.changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The work changed, so recovery of the earlier state stopped."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 상태가 바뀌어 이전 상태의 자동 처리를 중단했습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業の状態が変わったため、以前の状態の自動処理を停止しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工作状态已变化，因此停止对先前状态的自动处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "工作狀態已變化，因此停止對先前狀態的自動處理。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El trabajo cambió; se detuvo la recuperación del estado anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le travail a changé ; la récupération de l’état précédent a été arrêtée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Arbeit hat sich geändert; die Wiederherstellung des früheren Zustands wurde beendet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O trabalho mudou; a recuperação do estado anterior foi parada."
          }
        }
      }
    },
    "problem.automaticHistoryNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished failures are retained as history without requiring review. The bridge performs safe recovery automatically and records verified results. Active work, undelivered results, Codex conversations and project files are preserved."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료된 실패는 확인 의무 없이 기록으로 보관됩니다. 브리지가 안전한 복구를 자동 수행하고 확인된 결과를 기록합니다. 진행 중인 작업, 미전달 결과, Codex 대화와 프로젝트 파일은 보존합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了した失敗は確認不要の履歴として保持します。ブリッジが安全な復旧を自動実行し、検証済みの結果を記録します。進行中の作業、未配信の結果、Codexの会話とプロジェクトファイルは保持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已结束的失败保留为历史记录，无需标记查看。桥接器会自动进行安全恢复并记录已验证的结果。进行中的工作、未送达的结果、Codex对话和项目文件将保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已結束的失敗保留為歷史記錄，無須標記查看。橋接器會自動進行安全復原並記錄已驗證的結果。進行中的工作、未送達的結果、Codex對話和專案檔案將保留。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fallos finalizados se conservan sin revisión obligatoria. El puente realiza recuperaciones seguras y registra resultados verificados. Se conservan el trabajo activo, los resultados sin entregar, las conversaciones de Codex y los archivos del proyecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les échecs terminés sont conservés sans vérification obligatoire. Le pont effectue une récupération sûre et consigne les résultats vérifiés. Le travail actif, les résultats non remis, les conversations Codex et les fichiers du projet sont conservés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendete Fehler bleiben ohne Bestätigungspflicht im Verlauf. Die Bridge führt sichere Wiederherstellungen aus und protokolliert geprüfte Ergebnisse. Aktive Arbeit, nicht zugestellte Ergebnisse, Codex-Gespräche und Projektdateien bleiben erhalten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As falhas terminadas são conservadas sem revisão obrigatória. A ponte efetua recuperações seguras e regista resultados verificados. São preservados o trabalho ativo, os resultados não entregues, as conversas do Codex e os ficheiros do projeto."
          }
        }
      }
    },
