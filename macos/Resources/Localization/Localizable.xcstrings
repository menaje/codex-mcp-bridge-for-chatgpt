    "macOS에서 로그인 항목 실행 승인이 필요합니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS approval is required for this login item."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSでログイン項目の実行許可が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要在 macOS 中批准运行此登录项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要在 macOS 中批准執行此登入項。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS debe autorizar la ejecución de este elemento de inicio de sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS doit autoriser l’exécution de cet élément d’ouverture de session."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS muss die Ausführung dieses Anmeldeobjekts genehmigen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessária a aprovação do macOS para executar este item de início de sessão."
          }
        }
      }
    },
    "private .env와 Bridge 상태는 유지하고, 현재 Tunnel ID로 로컬 프로필만 다시 만듭니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps the private .env and Bridge state, and rebuilds only the local profile for the current Tunnel ID."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "private .envとBridgeの状態は保持し、現在のTunnel ID用のローカルプロファイルだけを再作成します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 private .env 和 Bridge 状态，仅为当前 Tunnel ID 重建本地配置文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留 private .env 和 Bridge 狀態，僅為目前 Tunnel ID 重建本地設定檔。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva el archivo .env privado y el estado de Bridge, y solo reconstruye el perfil local para el ID actual del Tunnel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve le fichier .env privé et l’état de Bridge, et reconstruit uniquement le profil local correspondant à l’ID actuel du Tunnel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die private .env und der Bridge-Status bleiben erhalten. Nur das lokale Profil für die aktuelle Tunnel-ID wird neu erstellt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o arquivo .env privado e o estado do Bridge e recria apenas o perfil local com o ID atual do Tunnel."
          }
        }
      }
    },
