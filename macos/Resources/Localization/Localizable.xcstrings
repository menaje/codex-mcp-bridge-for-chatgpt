          }
        }
      }
    },
    "연결할 폴더를 선택합니다. 실제 폴더나 파일은 이동하지 않습니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the folder to link. No folders or files will be moved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクするフォルダを選択します。実際のフォルダやファイルは移動しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要关联的文件夹。不会移动实际的文件夹或文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要關聯的資料夾。不會移動實際的資料夾或檔案。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija la carpeta que desea vincular. No se moverá ninguna carpeta ni archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le dossier à lier. Aucun dossier ni fichier ne sera déplacé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie den zu verknüpfenden Ordner aus. Es werden keine Ordner oder Dateien verschoben."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a pasta a vincular. Nenhuma pasta ou arquivo será movido."
          }
        }
      }
    },
    "프로젝트 이름 변경": {
      "extractionState": "manual",
