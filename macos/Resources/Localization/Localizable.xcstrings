          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Detener %d ejecuciones conectadas? Los cambios en archivos no se revierten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter %d exécutions liées ? Les modifications des fichiers seront conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%d verbundene Ausführungen stoppen? Dateiänderungen werden nicht rückgängig gemacht."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar %d execuções ligadas? As alterações nos ficheiros não serão revertidas."
          }
        }
      }
    },
    "문제 목록이나 실행 상태가 변경되었습니다. 갱신된 항목을 다시 선택해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The problem list or execution state changed. Select the refreshed entries again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제 목록이나 실행 상태가 변경되었습니다. 갱신된 항목을 다시 선택해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題一覧または実行状態が変わりました。更新された項目を再選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问题列表或执行状态已更改，请重新选择更新后的条目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "問題清單或執行狀態已變更，請重新選擇更新後的項目。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambió la lista o el estado de ejecución. Vuelve a seleccionar las entradas actualizadas."
          }
        },
        "fr": {
