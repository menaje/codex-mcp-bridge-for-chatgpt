    "지원되는 모델을 더 빠르게 실행합니다. 모델과 추론 수준은 유지되며, 사용량이나 비용이 늘어날 수 있습니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt unterstützte Modelle schneller aus. Modell und Denkstufe bleiben gleich; Verbrauch oder Kosten können steigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs supported models faster. The model and reasoning level stay the same; usage or costs may increase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta más rápido los modelos compatibles. El modelo y el nivel de razonamiento se mantienen; el consumo o el coste pueden aumentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accélère les modèles compatibles. Le modèle et le niveau de raisonnement restent identiques ; la consommation ou les coûts peuvent augmenter."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対応モデルをより速く実行します。モデルと推論レベルは維持されますが、使用量や料金が増える場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지원되는 모델을 더 빠르게 실행합니다. 모델과 추론 수준은 유지되며, 사용량이나 비용이 늘어날 수 있습니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Executa os modelos compatíveis mais rapidamente. O modelo e o nível de raciocínio permanecem iguais; o consumo ou o custo podem aumentar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更快地运行支持的模型。模型和推理强度保持不变，用量或费用可能增加。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更快地執行支援的模型。模型與推理強度保持不變，用量或費用可能增加。"
          }
        }
      }
    },
    "지정한 주소 또는 포트를 다른 프로그램이 사용 중입니다." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine andere Anwendung verwendet die angegebene Adresse oder den Port."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Another application is using the specified address or port."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra aplicación está usando la dirección o el puerto especificados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une autre application utilise l’adresse ou le port indiqué."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定したアドレスまたはポートは別のアプリケーションが使用しています。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro aplicativo está usando o endereço ou a porta especificados."
          }
        },
