    "Codex 앱에서 이 Agent의 대화를 엽니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens this Agent's conversation in the Codex app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このAgentの会話をCodexアプリで開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Codex 应用中打开此代理的对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Codex 應用中開啟此代理程式的對話。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la conversación de este agente en la app Codex."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre la conversation de cet agent dans l’app Codex."
          }
        },
