    "settings.developerModeRefreshRequired": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved and active. This deployment also changed the static tool contract; refresh the ChatGPT developer-mode connection once to adopt it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장되어 즉시 반영되었습니다. 이 배포에서 정적 도구 계약도 변경되었으므로 ChatGPT 개발자 모드 연결을 한 번 새로고침해 적용하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存され、反映されました。このデプロイでは静的ツール契約も変更されたため、ChatGPT の開発者モード接続を一度更新して適用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存并生效。此部署还更改了静态工具协议，请刷新一次 ChatGPT 开发者模式连接以应用更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存並生效。此部署也變更了靜態工具合約，請重新整理一次 ChatGPT 開發者模式連線以套用變更。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardado y activo. Este despliegue también cambió el contrato estático de herramientas; actualiza una vez la conexión del modo desarrollador de ChatGPT para aplicarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré et actif. Ce déploiement a aussi modifié le contrat statique des outils ; actualisez une fois la connexion du mode développeur de ChatGPT pour l’appliquer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichert und aktiv. Diese Bereitstellung hat auch den statischen Toolvertrag geändert; aktualisieren Sie die ChatGPT-Entwicklermodus-Verbindung einmal, um ihn zu übernehmen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo e ativo. Esta implantação também alterou o contrato estático das ferramentas; atualize uma vez a conexão do modo de desenvolvedor do ChatGPT para aplicá-lo."
          }
        }
      }
    },
