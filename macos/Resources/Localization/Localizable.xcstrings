          }
        }
      }
    },
    "백그라운드 작업만": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background Tasks Only"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
