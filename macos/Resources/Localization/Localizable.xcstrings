    "모델 카탈로그가 오래되어 정책 저장이 제한될 수 있습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model catalog is stale, so policy changes may be limited."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルカタログが古いため、ポリシーの保存が制限される場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型目录已过期，策略保存可能会受到限制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型目錄已過期，策略儲存可能會受到限制。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El catálogo de modelos está desactualizado, por lo que puede limitarse el guardado de la política."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le catalogue de modèles est obsolète ; l’enregistrement de la stratégie peut donc être limité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Modellkatalog ist veraltet. Das Speichern der Richtlinie kann daher eingeschränkt sein."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O catálogo de modelos está desatualizado, portanto o salvamento da política pode ser limitado."
          }
        }
      }
    },
    "반복 충돌로 자동 재시작이 중지되었습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic restart stopped after repeated crashes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラッシュが繰り返されたため、自動再起動を停止しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于反复崩溃，自动重启已停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於反覆崩潰，自動重啟已停止。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
