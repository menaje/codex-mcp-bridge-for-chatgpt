    "effort.high.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deeper review for complex work with a longer response time."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복잡한 작업을 더 깊게 검토하지만 응답 시간이 늘어날 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複雑な作業を深く検討しますが応答時間が長くなる場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更深入检查复杂任务，但响应可能更慢。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更深入檢查複雜工作，但回應可能較慢。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisión más profunda para tareas complejas, con mayor tiempo de respuesta."
          }
        },
        "fr": {
          "stringUnit": {
