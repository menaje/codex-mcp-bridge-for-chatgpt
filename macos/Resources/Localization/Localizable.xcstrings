    "macos.copiesvinstructionsandreferencematerialsintoa": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopiert Anweisungen und Referenzmaterialien von v%@ in eine neue unveränderliche Version. Die vorhandene Version bleibt unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copies v%@ instructions and reference materials into a new immutable version. The existing version does not change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia las instrucciones y los materiales de referencia de v%@ en una nueva versión inmutable. La versión existente no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copie les instructions et les documents de référence de v%@ dans une nouvelle version immuable. La version existante ne change pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "v%@の指示と参考資料をコピーして、新しい不変バージョンを作成します。既存のバージョンは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "v%@의 지침과 참고 자료를 복사해 새 불변 버전을 만듭니다. 기존 버전은 바뀌지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia as instruções e os materiais de referência de v%@ para uma nova versão imutável. A versão existente não é alterada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 v%@ 的说明和参考资料复制为新的不可变版本。现有版本不会更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 v%@ 的指示和參考資料複製為新的不可變版本。現有版本不會變更。"
          }
        }
      }
    },
    "macos.thisdoesnotchangetheserveritselfor": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server „%@“ selbst und Registrierungen auf anderen Geräten bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This does not change the “%@” server itself or registrations on other devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no modifica el servidor «%@» ni los registros de otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action ne modifie ni le serveur « %@ » lui-même ni les inscriptions des autres appareils."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」サーバー自体や他のデバイスの登録は変更されません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não altera o servidor “%@” nem os registros de outros dispositivos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会更改“%@”服务器本身或其他设备的注册。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會更改“%@”伺服器本身或其他裝置的註冊。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’ 서버 자체와 다른 기기의 등록은 변경하지 않습니다."
          }
        }
      }
    },
    "macos.thefolderandexistingworkhistorywillbe": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner „%@“ und der vorhandene Arbeitsverlauf bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ‘%@’ folder and existing work history will be preserved."
          }
        },
        "es": {
