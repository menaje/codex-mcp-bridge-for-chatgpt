        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência continuará quando for confirmado o fim do trabalho em segundo plano."
          }
        }
      }
    },
    "연결 해제를 확인하고 있습니다. 확인되면 Codex 앱을 엽니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
