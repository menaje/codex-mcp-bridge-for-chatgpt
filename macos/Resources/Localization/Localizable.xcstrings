          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（当前不可选择）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "（目前不可選擇）"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " (No disponible actualmente)"
          }
        },
        "fr": {
          "stringUnit": {
