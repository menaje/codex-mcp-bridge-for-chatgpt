    "원격 모드에서는 이 Mac의 helper나 Codex runtime을 시작하지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote mode does not start the helper or Codex runtime on this Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートモードでは、このMacのhelperやCodexランタイムを起動しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程模式不会启动此 Mac 上的 helper 或 Codex 运行时。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端模式不會啟動此 Mac 上的 helper 或 Codex 執行時。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo remoto no inicia el helper ni el entorno de ejecución de Codex en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode distant ne démarre ni le helper ni l’environnement d’exécution Codex sur ce Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
