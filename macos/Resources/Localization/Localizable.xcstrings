    "problem.stopConfirm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop {count} connected executions? File changes will not be reverted."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 실행 {count}개를 중단할까요? 파일 변경사항은 되돌리지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続された{count}件の実行を停止しますか？ファイルの変更は元に戻りません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止{count}个关联执行？文件修改不会撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止{count}個關聯執行？檔案修改不會撤銷。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Detener {count} ejecuciones conectadas? Los cambios en archivos no se revierten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter {count} exécutions liées ? Les modifications des fichiers seront conservées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{count} verbundene Ausführungen stoppen? Dateiänderungen werden nicht rückgängig gemacht."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar {count} execuções ligadas? As alterações nos ficheiros não serão revertidas."
          }
        }
      }
    },
    "problem.changed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The problem list or execution state changed. Select the refreshed entries again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제 목록이나 실행 상태가 변경되었습니다. 갱신된 항목을 다시 선택해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
