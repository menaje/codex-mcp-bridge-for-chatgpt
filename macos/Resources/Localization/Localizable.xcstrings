    "다음 사용자 로그인부터 메뉴 막대 앱이 자동으로 열립니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The menu bar app will open automatically at the next user login."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回のユーザーログインからメニューバーアプリが自動的に開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从下次用户登录起，菜单栏应用将自动打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從下次使用者登入起，選單欄應用將自動開啟。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app de la barra de menús se abrirá automáticamente a partir del próximo inicio de sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app de la barre des menus s’ouvrira automatiquement à partir de la prochaine ouverture de session."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
