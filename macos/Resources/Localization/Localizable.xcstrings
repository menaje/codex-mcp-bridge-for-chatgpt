    "비용 조회용 관리자 키를 별도로 사용합니다. 실행 로그인은 변경하지 않습니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비용 조회용 관리자 키를 별도로 사용합니다. 실행 로그인은 변경하지 않습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses a separate admin key for costs. Your execution sign-in stays the same."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "費用照会には別の管理者キーを使用します。実行用ログインは変更しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用单独的管理员密钥查询费用，不更改执行登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用獨立的管理員金鑰查詢費用，不會更改執行登入。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una clave de administrador independiente para costes. El inicio de sesión de ejecución no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise une clé d’administration distincte pour les coûts. La connexion d’exécution ne change pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet einen separaten Administratorschlüssel für Kosten. Die Ausführungsanmeldung bleibt unverändert."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa uma chave de administrador separada para custos. O login de execução não muda."
          }
        }
      }
    },
