    "연결 정보는 심볼릭 링크가 아닌 일반 파일이어야 합니다." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindungsdaten müssen in einer regulären Datei und nicht in einem symbolischen Link gespeichert sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connection details must be stored in a regular file, not a symbolic link."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los datos de conexión deben guardarse en un archivo normal, no en un enlace simbólico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les informations de connexion doivent être stockées dans un fichier ordinaire, et non dans un lien symbolique."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続情報はシンボリックリンクではなく通常のファイルである必要があります。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os detalhes da conexão devem ser armazenados em um arquivo comum, não em um link simbólico."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接信息必须存储在普通文件中，不能是符号链接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連線資訊必須儲存在普通檔案中，不能是符號連結。"
          }
        }
      }
    },
    "연결 탭에서 서버를 선택하거나 페어링해 주세요." : {
