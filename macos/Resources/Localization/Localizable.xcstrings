    "settings.modelDescriptions.conflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings changed elsewhere. Your text is kept. Review the saved description and save again."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 화면에서 설정이 변경되었습니다. 입력한 내용은 유지됩니다. 저장된 설명을 확인한 뒤 다시 저장해 주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の画面で設定が変更されました。入力内容は保持されています。保存済みの説明を確認して再度保存してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置已在其他界面更改。输入内容已保留。请确认已保存的说明后再次保存。"
          }
        },
        "zh-Hant": {
