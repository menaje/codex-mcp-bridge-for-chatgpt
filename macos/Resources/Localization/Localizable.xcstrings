    "다른 화면에서 설정이 변경되었습니다. 입력한 내용은 유지됩니다. 저장된 설명을 확인한 뒤 다시 저장해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings changed elsewhere. Your text is kept. Review the saved description and save again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の画面で設定が変更されました。入力内容は保持されています。保存済みの説明を確認して再度保存してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置已在其他界面更改。输入内容已保留。请确认已保存的说明后再次保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定已在其他畫面變更。輸入內容已保留。請確認已儲存的說明後再次儲存。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración cambió en otra pantalla. Tu texto se conserva. Revisa la descripción guardada y vuelve a guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres ont changé dans une autre fenêtre. Votre texte est conservé. Vérifiez la description enregistrée, puis enregistrez à nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungen wurden an anderer Stelle geändert. Ihr Text bleibt erhalten. Prüfen Sie die gespeicherte Beschreibung und speichern Sie erneut."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações mudaram em outra tela. Seu texto foi mantido. Confira a descrição salva e salve novamente."
          }
        }
      }
    },
