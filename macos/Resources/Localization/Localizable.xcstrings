    "연결 정보 파일 또는 폴더의 접근 권한이 너무 넓습니다. 앱 전용 권한으로 제한해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection file or folder permissions are too broad. Restrict them to app-only access."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続情報のファイルまたはフォルダのアクセス権限が広すぎます。アプリ専用に制限してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接信息文件或文件夹的权限范围过宽。请将其限制为仅供应用访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線資訊檔案或資料夾的權限範圍過寬。請將其限制為僅供應用存取。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los permisos del archivo o la carpeta de conexión son demasiado amplios. Limítelos al acceso exclusivo de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autorisations du fichier ou dossier de connexion sont trop larges. Limitez-les à l’accès de l’app uniquement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Berechtigungen der Verbindungsdatei oder des Ordners sind zu weit gefasst. Beschränken Sie sie auf den Zugriff durch die App."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As permissões do arquivo ou da pasta de conexão são muito amplas. Restrinja-as ao acesso exclusivo do aplicativo."
          }
        }
      }
    },
    "연결 정보는 심볼릭 링크가 아닌 일반 파일이어야 합니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection details must be stored in a regular file, not a symbolic link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続情報はシンボリックリンクではなく通常のファイルである必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接信息必须存储在普通文件中，不能是符号链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線資訊必須儲存在普通檔案中，不能是符號連結。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de conexión deben guardarse en un archivo normal, no en un enlace simbólico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations de connexion doivent être stockées dans un fichier ordinaire, et non dans un lien symbolique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindungsdaten müssen in einer regulären Datei und nicht in einem symbolischen Link gespeichert sein."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os detalhes da conexão devem ser armazenados em um arquivo comum, não em um link simbólico."
          }
        }
      }
    },
    "연결 탭에서 서버를 선택하거나 페어링해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select or pair a server in the Connection tab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「接続」タブでサーバーを選択またはペアリングしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“连接”标签页中选择或配对服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在“連線”標籤頁中選擇或配對伺服器。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione o empareje un servidor en la pestaña Conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez ou jumelez un serveur dans l’onglet Connexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen oder koppeln Sie einen Server im Tab „Verbindung“."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione ou pareie um servidor na aba Conexão."
          }
        }
      }
    },
