    "먼저 ‘기존 서버에 연결’ 모드를 선택해 주세요." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie zuerst den Modus „Mit vorhandenem Server verbinden“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select “Connect to Existing Server” mode first."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleccione primero el modo «Conectar a un servidor existente»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez d’abord le mode « Se connecter à un serveur existant »."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先に「既存のサーバーに接続」モードを選択してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeiro selecione o modo “Conectar a um servidor existente”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先选择“连接现有服务器”模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先選擇“連線現有伺服器”模式。"
          }
        }
      }
    },
    "메뉴 막대 앱, helper, 브리지 서버와 Tunnel을 모두 종료합니다. 앱을 다시 열거나 다음 사용자 로그인 전까지 ChatGPT의 브리지 연결을 사용할 수 없습니다." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beendet die Menüleisten-App, den Helper, den Bridge-Server und den Tunnel. Die Bridge-Verbindung von ChatGPT bleibt bis zum erneuten Öffnen der App oder bis zur nächsten Anmeldung nicht verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quits the menu bar app, helper, bridge server, and Tunnel. The ChatGPT bridge connection remains unavailable until you reopen the app or next log in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra la app de la barra de menús, el helper, el servidor Bridge y el Tunnel. La conexión de ChatGPT con Bridge no estará disponible hasta que vuelva a abrir la app o inicie sesión de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ferme l’app de la barre des menus, le helper, le serveur Bridge et le Tunnel. La connexion de ChatGPT au Bridge restera indisponible jusqu’à la réouverture de l’app ou la prochaine ouverture de session."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーアプリ、helper、Bridgeサーバー、Tunnelをすべて終了します。アプリを再度開くか次回ログインするまで、ChatGPTからBridgeに接続できません。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerra o aplicativo da barra de menus, o helper, o servidor Bridge e o Tunnel. A conexão do ChatGPT com o Bridge ficará indisponível até o aplicativo ser reaberto ou o próximo início de sessão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将退出菜单栏应用、helper、Bridge 服务器和 Tunnel。在重新打开应用或下次登录之前，ChatGPT 无法连接到 Bridge。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將退出選單欄應用、helper、Bridge 伺服器和 Tunnel。在重新開啟應用或下次登入之前，ChatGPT 無法連線到 Bridge。"
          }
        }
      }
    },
    "메뉴 막대 앱과 helper, 브리지 서버 및 관련 프로세스를 모두 종료합니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beendet die Menüleisten-App, den Helper, den Bridge-Server und alle zugehörigen Prozesse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quits the menu bar app, helper, bridge server, and all related processes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cierra la app de la barra de menús, el helper, el servidor Bridge y todos los procesos relacionados."
          }
        },
        "fr" : {
