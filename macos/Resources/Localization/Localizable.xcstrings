          }
        }
      }
    },
    "서버 인증서 확인 값이 올바르지 않습니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server certificate fingerprint is invalid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー証明書のフィンガープリントが無効です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器证书指纹无效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器憑證指紋無效。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La huella del certificado del servidor no es válida."
          }
        },
        "fr": {
