            "value": "Examen approfondi des tâches complexes, avec un temps de réponse accru."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiefere Prüfung komplexer Aufgaben mit längerer Antwortzeit."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisão mais profunda de tarefas complexas, com maior tempo de resposta."
          }
        }
      }
    },
    "effort.xhigh.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Very deep reasoning for difficult tasks; responses can take substantially longer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어려운 작업을 매우 깊게 추론하므로 응답이 상당히 오래 걸릴 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "難しい作業を非常に深く推論するため、応答にかなり時間がかかる場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对困难任务进行非常深入的推理，响应可能明显更慢。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對困難工作進行非常深入的推理，回應可能明顯較慢。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Razonamiento muy profundo para tareas difíciles; puede tardar bastante más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raisonnement très approfondi pour les tâches difficiles ; la réponse peut être nettement plus longue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehr tiefes Reasoning für schwierige Aufgaben; Antworten können deutlich länger dauern."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Raciocínio muito profundo para tarefas difíceis; a resposta pode demorar bem mais."
          }
        }
      }
    },
    "effort.max.description": {
      "localizations": {
