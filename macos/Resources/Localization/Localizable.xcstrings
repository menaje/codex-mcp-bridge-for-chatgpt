          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於無法儲存待處理的伺服器設定，因此未更改連線模式。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
