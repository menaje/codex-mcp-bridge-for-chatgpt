    "선택한 서버의 프로젝트를 관리합니다. 모든 경로는 원격 서버 호스트의 파일시스템 기준입니다." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwaltet Projekte auf dem ausgewählten Server. Alle Pfade beziehen sich auf das Dateisystem des Remote-Serverhosts."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manage projects on the selected server. All paths refer to the remote server host’s filesystem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestiona los proyectos del servidor seleccionado. Todas las rutas corresponden al sistema de archivos del host remoto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gérez les projets du serveur sélectionné. Tous les chemins se rapportent au système de fichiers de l’hôte distant."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したサーバーのプロジェクトを管理します。すべてのパスはリモートサーバーホストのファイルシステムを基準とします。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerencie os projetos no servidor selecionado. Todos os caminhos se referem ao sistema de arquivos do host do servidor remoto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理所选服务器上的项目。所有路径均以远程服务器主机的文件系统为准。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
