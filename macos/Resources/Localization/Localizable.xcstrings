    "macos.connectionAssistant.recoveryDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst werden nur Komponenten mit Handlungsbedarf angezeigt; bereite Komponenten bleiben zusammengefasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only components that need attention are shown first. Ready components stay summarized."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero se muestran solo los componentes que requieren atención; los listos se resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les composants nécessitant votre attention sont affichés en premier ; les autres sont résumés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応が必要なコンポーネントだけを先に表示し、準備済みの項目は要約します。"
