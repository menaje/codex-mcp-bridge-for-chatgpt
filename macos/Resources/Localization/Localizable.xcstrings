    "problem.auto.confirmed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bridge verified the recovery result. Task results are kept in execution history."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브리지가 조치 결과를 확인했습니다. 작업 결과는 실행 기록에 보관됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブリッジが処理結果を検証しました。作業結果は実行履歴に保持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "桥接器已验证处理结果。任务结果保存在执行记录中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "橋接器已驗證處理結果。任務結果保存在執行記錄中。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puente verificó la recuperación. Los resultados de la tarea se conservan en el historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pont a vérifié le résultat de la récupération. Les résultats de la tâche restent dans l’historique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bridge hat das Wiederherstellungsergebnis geprüft. Aufgabenergebnisse bleiben im Ausführungsverlauf."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A ponte verificou o resultado da recuperação. Os resultados da tarefa ficam no histórico."
          }
        }
      }
    },
    "problem.auto.protected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active or background work is being preserved."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진행 중이거나 백그라운드에서 실행 중인 작업을 보존합니다."
          }
        },
        "ja": {
