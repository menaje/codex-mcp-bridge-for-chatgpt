    "공용 인터넷 포트를 자동으로 열지 않습니다. 신뢰하는 LAN 또는 개인 VPN에서 접근할 HTTPS 주소를 지정하세요." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird nicht automatisch ein öffentlicher Internet-Port geöffnet. Geben Sie eine HTTPS-Adresse an, die über ein vertrauenswürdiges LAN oder privates VPN erreichbar ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No public internet port is opened automatically. Specify an HTTPS address reachable through a trusted LAN or private VPN."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se abre automáticamente ningún puerto público de Internet. Indique una dirección HTTPS accesible desde una LAN de confianza o una VPN privada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun port Internet public n’est ouvert automatiquement. Indiquez une adresse HTTPS accessible depuis un réseau local de confiance ou un VPN privé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公開インターネットポートは自動では開きません。信頼できるLANまたはプライベートVPNからアクセス可能なHTTPSアドレスを指定してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma porta pública da Internet é aberta automaticamente. Informe um endereço HTTPS acessível por uma LAN confiável ou VPN privada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不会自动开放公共互联网端口。请指定可通过可信局域网或专用 VPN 访问的 HTTPS 地址。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不會自動開放公共網際網路埠。請指定可透過可信區域網路或專用 VPN 存取的 HTTPS 地址。"
          }
        }
      }
    },
    "관련 프로세스를 모두 종료하지 못했습니다" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht alle zugehörigen Prozesse konnten beendet werden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could Not Stop All Related Processes"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron detener todos los procesos relacionados"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’arrêter tous les processus associés"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "関連プロセスをすべて停止できませんでした"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
