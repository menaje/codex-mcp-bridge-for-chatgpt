        }
      }
    },
    "실행 상태를 다시 확인하고 있습니다. 예약은 유지됩니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 상태를 다시 확인하고 있습니다. 예약은 유지됩니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechecking the runtime. Your reservation is retained."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行状態を再確認しています。予約は維持されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在重新检查运行状态，预约将继续保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在重新檢查執行狀態，預約將繼續保留。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volviendo a comprobar el estado. La reserva se mantiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouvelle vérification de l’état. Votre réservation est conservée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Laufzeitstatus wird erneut geprüft. Ihre Reservierung bleibt erhalten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificando o estado novamente. Sua reserva será mantida."
          }
        }
      }
    },
    "작업이 끝나면 helper를 갱신하도록 예약했습니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업이 끝나면 helper를 갱신하도록 예약했습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The helper will update when the current work finishes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業が終わるとhelperを更新するよう予約しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已预约在当前任务完成后更新 helper。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已預約在目前工作完成後更新 helper。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El helper se actualizará cuando termine el trabajo actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le helper sera mis à jour à la fin du travail en cours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Helper wird aktualisiert, sobald die aktuelle Arbeit beendet ist."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O helper será atualizado quando o trabalho atual terminar."
          }
        }
      }
    },
    "이미 예약된 작업이 있습니다. 예약을 취소한 뒤 다시 요청해 주세요.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 예약된 작업이 있습니다. 예약을 취소한 뒤 다시 요청해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An operation is already reserved. Cancel it before submitting another request."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに予約された処理があります。予約を取り消してから再度リクエストしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有预约操作。请先取消，再提交新请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有預約操作。請先取消，再提交新請求。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay una operación reservada. Cancélala antes de enviar otra solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une opération est déjà réservée. Annulez-la avant d’envoyer une autre demande."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist bereits ein Vorgang vorgemerkt. Brechen Sie ihn ab, bevor Sie eine neue Anfrage stellen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existe uma operação reservada. Cancele-a antes de enviar outra solicitação."
          }
        }
      }
    },
    "서버 시작 예약": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버 시작 예약"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server start reserved"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー起動を予約"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已预约启动服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已預約啟動伺服器"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicio del servidor reservado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrage du serveur réservé"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverstart vorgemerkt"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicialização do servidor reservada"
          }
        }
      }
    },
    "작업 접수를 다시 열지 못했습니다. 서버 상태를 확인해 주세요.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 접수를 다시 열지 못했습니다. 서버 상태를 확인해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not resume accepting work. Check the server status."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業の受付を再開できませんでした。サーバーの状態を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法恢复接收任务。请检查服务器状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法恢復接收工作。請檢查伺服器狀態。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo reanudar la recepción de tareas. Comprueba el estado del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de reprendre la réception des tâches. Vérifiez l’état du serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Annahme von Aufgaben konnte nicht fortgesetzt werden. Prüfe den Serverstatus."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível retomar a recepção de tarefas. Verifique o estado do servidor."
          }
        }
      }
    },
    "서버가 연결 준비를 마치기 전에 종료되었습니다. 설치와 연결 설정을 확인해 주세요.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 연결 준비를 마치기 전에 종료되었습니다. 설치와 연결 설정을 확인해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server exited before the connection was ready. Check the installation and connection settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続の準備が完了する前にサーバーが終了しました。インストールと接続設定を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器在连接就绪前已退出。请检查安装和连接设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器在連線就緒前已結束。請檢查安裝與連線設定。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor se cerró antes de que la conexión estuviera lista. Comprueba la instalación y la configuración de conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur s’est arrêté avant que la connexion soit prête. Vérifiez l’installation et les paramètres de connexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server wurde beendet, bevor die Verbindung bereit war. Prüfe die Installation und die Verbindungseinstellungen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor foi encerrado antes de a conexão estar pronta. Verifique a instalação e as configurações de conexão."
          }
        }
      }
    },
    "브리지 helper를 종료하지 못했습니다. 관련 프로세스 상태를 확인해 주세요.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브리지 helper를 종료하지 못했습니다. 관련 프로세스 상태를 확인해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not stop the bridge helper. Check the related processes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブリッジのhelperを終了できませんでした。関連プロセスの状態を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法停止桥接 helper。请检查相关进程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法停止橋接 helper。請檢查相關程序。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo detener el helper del puente. Comprueba los procesos relacionados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’arrêter le helper du pont. Vérifiez les processus associés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bridge-Helper konnte nicht beendet werden. Prüfe die zugehörigen Prozesse."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível encerrar o helper da ponte. Verifique os processos relacionados."
          }
        }
      }
    },
    "관련 프로세스의 확인 또는 종료를 마치지 못했습니다. 서버 상태를 확인해 주세요.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관련 프로세스의 확인 또는 종료를 마치지 못했습니다. 서버 상태를 확인해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not finish checking or stopping the related processes. Check the server status."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関連プロセスの確認または終了を完了できませんでした。サーバーの状態を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能完成相关进程的检查或停止。请检查服务器状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能完成相關程序的檢查或停止。請檢查伺服器狀態。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la comprobación o detención de los procesos relacionados. Comprueba el estado del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de terminer la vérification ou l’arrêt des processus associés. Vérifiez l’état du serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die zugehörigen Prozesse konnten nicht vollständig geprüft oder beendet werden. Prüfe den Serverstatus."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a verificação ou o encerramento dos processos relacionados. Verifique o estado do servidor."
          }
        }
      }
    },
    "로컬 서비스의 응답을 확인하지 못해 후속 처리를 마치지 못했습니다. 다시 요청해 주세요.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 서비스의 응답을 확인하지 못해 후속 처리를 마치지 못했습니다. 다시 요청해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not finish the follow-up action because the local service response could not be verified. Submit the request again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルサービスの応答を確認できず、後続処理を完了できませんでした。再度リクエストしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认本地服务的响应，因此未能完成后续操作。请重新提交请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認本機服務的回應，因此未能完成後續操作。請重新提交請求。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la acción posterior porque no se pudo verificar la respuesta del servicio local. Vuelve a enviar la solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de terminer l’action suivante, car la réponse du service local n’a pas pu être vérifiée. Envoyez à nouveau la demande."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Folgeaktion konnte nicht abgeschlossen werden, weil die Antwort des lokalen Dienstes nicht geprüft werden konnte. Sende die Anfrage erneut."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a ação seguinte porque a resposta do serviço local não pôde ser verificada. Envie a solicitação novamente."
          }
        }
      }
    },
    "설정 변경사항을 저장하지 못해 후속 처리를 중단했습니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 변경사항을 저장하지 못해 후속 처리를 중단했습니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The follow-up action stopped because the settings changes could not be saved."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定の変更を保存できなかったため、後続処理を中止しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
