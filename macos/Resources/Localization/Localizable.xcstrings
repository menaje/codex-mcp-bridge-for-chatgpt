    "macos.skills.selectedFilesAreAddedOrReplacedAsAttachmentsTheMainDocumentIsReplacedOnlyWhenYouExplicitlySelectOne": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected files are added or replaced as attachments. SKILL.md content is replaced only when you explicitly select a file for it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 파일은 첨부 파일로 추가되거나 교체됩니다. SKILL.md 본문은 사용할 파일을 명시적으로 선택한 경우에만 교체됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したファイルは添付ファイルとして追加または置換されます。SKILL.md の内容は、使用するファイルを明示的に選択した場合にのみ置換されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选文件将作为附件添加或替换。只有明确选择用于 SKILL.md 的文件时，其内容才会被替换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選檔案將作為附件新增或取代。只有明確選擇用於 SKILL.md 的檔案時，其內容才會被取代。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos seleccionados se añaden o reemplazan como adjuntos. El contenido de SKILL.md solo se reemplaza cuando eliges explícitamente un archivo para ello."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sélectionnés sont ajoutés ou remplacés comme pièces jointes. Le contenu de SKILL.md est remplacé uniquement si vous choisissez explicitement un fichier pour celui-ci."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Dateien werden als Anlagen hinzugefügt oder ersetzt. Der SKILL.md-Inhalt wird nur ersetzt, wenn Sie ausdrücklich eine Datei dafür auswählen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos selecionados são adicionados ou substituídos como anexos. O conteúdo do SKILL.md só é substituído quando você seleciona explicitamente um arquivo para ele."
          }
        }
      }
    },
