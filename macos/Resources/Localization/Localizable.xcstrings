    "settings.sharedNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These settings are shared by all conversations using this bridge instance, not stored per ChatGPT account. Bridge security policy cannot be changed here."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정은 ChatGPT 계정별 값이 아니라 이 브리지 인스턴스를 사용하는 모든 대화에 공유됩니다. 브리지 보안 정책은 여기서 변경할 수 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定は ChatGPT アカウント別ではなく、このブリッジインスタンスを使用するすべての会話で共有されます。ブリッジのセキュリティポリシーはここでは変更できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些设置不会按 ChatGPT 账户保存，而是由使用此桥接实例的所有对话共享。桥接安全策略无法在此更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些設定不是依 ChatGPT 帳戶儲存，而是由使用此橋接執行個體的所有對話共用。橋接安全政策無法在此變更。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta configuración se comparte entre todas las conversaciones que usan esta instancia del puente; no se guarda por cuenta de ChatGPT. La política de seguridad del puente no puede cambiarse aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces paramètres sont partagés par toutes les conversations utilisant cette instance du pont ; ils ne sont pas enregistrés par compte ChatGPT. La politique de sécurité du pont ne peut pas être modifiée ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einstellungen werden von allen Unterhaltungen gemeinsam genutzt, die diese Bridge-Instanz verwenden; sie werden nicht pro ChatGPT-Konto gespeichert. Die Sicherheitsrichtlinie der Bridge kann hier nicht geändert werden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas configurações são compartilhadas por todas as conversas que usam esta instância da ponte; não são salvas por conta do ChatGPT. A política de segurança da ponte não pode ser alterada aqui."
          }
        }
      }
    },
    "settings.warning.catalogStale": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model catalog could not be refreshed. The last successfully verified catalog is shown temporarily."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 카탈로그를 새로고침하지 못했습니다. 마지막으로 검증에 성공한 카탈로그를 임시로 표시합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルカタログを更新できませんでした。最後に検証できたカタログを一時的に表示しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法刷新模型目录。当前暂时显示上次成功验证的目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法重新整理模型目錄。目前暫時顯示上次成功驗證的目錄。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo actualizar el catálogo de modelos. Se muestra temporalmente el último catálogo verificado correctamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le catalogue de modèles n’a pas pu être actualisé. Le dernier catalogue correctement vérifié est affiché temporairement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Modellkatalog konnte nicht aktualisiert werden. Vorübergehend wird der zuletzt erfolgreich geprüfte Katalog angezeigt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atualizar o catálogo de modelos. O último catálogo verificado com sucesso está sendo exibido temporariamente."
          }
        }
      }
    },
    "settings.warning.catalogUnavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model catalog is unavailable. Restore backend access and retry model lookup."
          }
