    "macos.skills.thisSkillIsArchivedAndExcludedFromSearchResultsItsImmutableVersionsRemainReadable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This skill is archived and excluded from search results. Its immutable versions remain readable."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스킬은 보관되어 검색 결과에서 제외됩니다. 불변 버전은 계속 읽을 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスキルはアーカイブされ、検索結果から除外されています。不変バージョンは引き続き読み取れます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此技能已归档并从搜索结果中排除，其不可变版本仍可读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此技能已封存並從搜尋結果排除，其不可變版本仍可讀取。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta habilidad está archivada y excluida de los resultados. Sus versiones inmutables siguen disponibles para lectura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette compétence est archivée et exclue des résultats. Ses versions immuables restent consultables."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Fähigkeit ist archiviert und von Suchergebnissen ausgeschlossen. Ihre unveränderlichen Versionen bleiben lesbar."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta habilidade está arquivada e excluída dos resultados. Suas versões imutáveis continuam disponíveis para leitura."
          }
        }
      }
    },
