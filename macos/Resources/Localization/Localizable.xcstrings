    "브리지 helper가 제한 시간 안에 종료되지 않았습니다. 관련 프로세스가 남아 있을 수 있습니다." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bridge-helper wurde nicht vor Ablauf des Zeitlimits beendet. Zugehörige Prozesse werden möglicherweise noch ausgeführt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bridge helper did not stop before the timeout. Related processes may still be running."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El helper de Bridge no se detuvo antes de que se agotara el tiempo de espera. Es posible que aún haya procesos relacionados en ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le helper Bridge ne s’est pas arrêté avant l’expiration du délai. Des processus associés sont peut-être encore actifs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge helperは制限時間内に終了しませんでした。関連プロセスが残っている可能性があります。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O helper do Bridge não foi interrompido antes do tempo limite. Processos relacionados ainda podem estar em execução."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bridge helper 未能在超时前停止。相关进程可能仍在运行。"
          }
