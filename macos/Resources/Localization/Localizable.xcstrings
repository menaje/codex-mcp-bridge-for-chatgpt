    "확인할 수 없는 백그라운드 프로세스를 무시하고 강제로 재시작할까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore unverified background processes and force a restart?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認できないバックグラウンドプロセスを無視して強制再起動しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忽略无法确认的后台进程并强制重启？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "忽略無法確認的背景程序並強制重啟？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ignorar los procesos en segundo plano no verificados y forzar un reinicio?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorer les processus en arrière-plan non vérifiés et forcer le redémarrage ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht überprüfbare Hintergrundprozesse ignorieren und einen Neustart erzwingen?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorar os processos em segundo plano que não puderam ser verificados e forçar uma reinicialização?"
          }
        }
      }
    },
