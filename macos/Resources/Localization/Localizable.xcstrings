    "macos.settings.modelAndExecutionDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardzugriff, Modellrichtlinie, Reasoning, Fast, Parallelität und Aufbewahrung festlegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set default access, model policy, reasoning, Fast mode, concurrency, and retention."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura el acceso predeterminado, la política de modelos, el razonamiento, Fast, la concurrencia y la retención."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez l’accès par défaut, la politique de modèles, le raisonnement, Fast, la concurrence et la conservation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
