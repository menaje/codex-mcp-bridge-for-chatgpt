    "macos.theappwasnotquitbecausesettingschanges": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App wurde nicht beendet, da die Einstellungsänderungen nicht gespeichert werden konnten. Beheben Sie den Speicherfehler und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app was not quit because settings changes could not be saved. Resolve the save error and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no se cerró porque no se pudieron guardar los cambios de configuración. Resuelva el error de guardado e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app n’a pas été fermée, car les modifications des paramètres n’ont pas pu être enregistrées. Corrigez l’erreur d’enregistrement, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定変更を保存できなかったため、アプリを終了しませんでした。保存エラーを解決してから、もう一度お試しください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplicativo não foi encerrado porque não foi possível salvar as alterações nas configurações. Resolva o erro de salvamento e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于无法保存设置更改，应用未退出。请解决保存错误后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於無法儲存設定更改，應用未退出。請解決儲存錯誤後重試。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 변경사항을 저장하지 못해 앱을 종료하지 않았습니다. 저장 오류를 해결한 뒤 다시 시도해 주세요."
          }
        }
      }
    },
    "macos.thefollowupactionstoppedbecausethesettings": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Folgeaktion wurde angehalten, weil die Einstellungsänderungen nicht gespeichert werden konnten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The follow-up action stopped because the settings changes could not be saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La acción posterior se detuvo porque no se pudieron guardar los cambios de configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’action suivante a été interrompue, car les modifications des paramètres n’ont pas pu être enregistrées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定の変更を保存できなかったため、後続処理を中止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 변경사항을 저장하지 못해 후속 처리를 중단했습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A ação seguinte foi interrompida porque as alterações nas configurações não puderam ser salvas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于无法保存设置更改，后续操作已中止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於無法儲存設定變更，後續操作已中止。"
          }
        }
      }
    },
