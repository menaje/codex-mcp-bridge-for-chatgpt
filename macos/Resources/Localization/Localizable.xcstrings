          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A reinicialização automática foi interrompida após falhas repetidas."
          }
        }
      }
    },
    "백엔드 전환 시 알아둘 점": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
