    "중단된 작업은 자동으로 다시 실행하지 않습니다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrupted tasks will not restart automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中断されたタスクは自動的に再実行されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被中断的任务不会自动重新运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "被中斷的任務不會自動重新執行。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas interrumpidas no se reiniciarán automáticamente."
          }
        },
        "fr": {
