      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Berechtigungen der Verbindungsdatei oder des Ordners sind zu weit gefasst. Beschränken Sie sie auf den Zugriff durch die App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection file or folder permissions are too broad. Restrict them to app-only access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los permisos del archivo o la carpeta de conexión son demasiado amplios. Limítelos al acceso exclusivo de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autorisations du fichier ou dossier de connexion sont trop larges. Limitez-les à l’accès de l’app uniquement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続情報のファイルまたはフォルダのアクセス権限が広すぎます。アプリ専用に制限してください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As permissões do arquivo ou da pasta de conexão são muito amplas. Restrinja-as ao acesso exclusivo do aplicativo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接信息文件或文件夹的权限范围过宽。请将其限制为仅供应用访问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連線資訊檔案或資料夾的權限範圍過寬。請將其限制為僅供應用存取。"
          }
        }
      }
    },
    "연결 정보 파일을 등록된 프로젝트 폴더 밖으로 이동해 주세요." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschieben Sie die Verbindungsdatei aus allen registrierten Projektordnern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move the connection file outside all registered project folders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueva el archivo de conexión fuera de todas las carpetas de proyectos registradas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacez le fichier de connexion en dehors de tous les dossiers de projets enregistrés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
