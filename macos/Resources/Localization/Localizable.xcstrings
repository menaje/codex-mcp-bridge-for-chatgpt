    "선택한 Tunnel ID의 Runtime API 키를 읽을 수 없습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Runtime API key for the selected Tunnel ID could not be read."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したTunnel IDのRuntime APIキーを読み取れません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取所选 Tunnel ID 的 Runtime API 密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取所選 Tunnel ID 的 Runtime API 金鑰。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la clave de API de Runtime del ID del Tunnel seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
