          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As informações de conexão encontradas foram inseridas."
          }
        }
      }
    },
    "클라이언트 Mac의 연결 화면에 붙여넣을 1회용 초대를 만듭니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a one-time invitation to paste into the Connection screen on the client Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クライアントMacの接続画面に貼り付ける1回限りの招待を作成します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建一个一次性邀请，用于粘贴到客户端 Mac 的“连接”页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立一個一次性邀請，用於貼到用戶端 Mac 的「連線」畫面。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una invitación de un solo uso para pegarla en la pantalla Conexión del Mac cliente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée une invitation à usage unique à coller dans l’écran Connexion du Mac client."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt eine einmal verwendbare Einladung zum Einfügen im Verbindungsbildschirm des Client-Macs."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria um convite de uso único para colar na tela Conexão do Mac cliente."
          }
        }
      }
    },
    "클립보드에서 두 값 가져오기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import both values from clipboard"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードから両方の値を読み込む"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从剪贴板导入两个值"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從剪貼簿匯入兩個值"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar ambos valores del portapapeles"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
