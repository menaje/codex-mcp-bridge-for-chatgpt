    "macos.thebridgerecognizesonlyconversationcodextaskand": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bridge erkennt nur conversation, codex-task und reference-text. Bereiten Sie Umgebungsanforderungen separat in der Ausführungsumgebung vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Bridge recognizes only conversation, codex-task, and reference-text. Prepare environment requirements separately in the execution environment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Bridge solo reconoce conversation, codex-task y reference-text. Prepare los requisitos de entorno por separado en el entorno de ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Bridge ne reconnaît que conversation, codex-task et reference-text. Préparez séparément les prérequis d’environnement dans l’environnement d’exécution."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge が認識するのは conversation、codex-task、reference-text のみです。環境要件は実行環境で別途準備してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브리지 기능은 conversation, codex-task, reference-text만 인식합니다. 환경 조건은 실행 환경에서 따로 준비해야 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bridge reconhece apenas conversation, codex-task e reference-text. Prepare os requisitos de ambiente separadamente no ambiente de execução."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge 仅识别 conversation、codex-task 和 reference-text。请在执行环境中单独准备环境要求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge 僅識別 conversation、codex-task 和 reference-text。請在執行環境中另外準備環境需求。"
          }
        }
      }
    },
