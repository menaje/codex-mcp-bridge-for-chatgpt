    "현재 사용자가 소유한 로컬 서비스가 아니므로 연결을 거부했습니다." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung wurde abgelehnt, da der lokale Dienst nicht dem aktuellen Benutzer gehört."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection was refused because the local service is not owned by the current user."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se rechazó la conexión porque el servicio local no pertenece al usuario actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
