    "일부 추가 정보를 갱신하지 못했습니다. 마지막 확인값이 표시될 수 있습니다.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Details konnten nicht aktualisiert werden. Möglicherweise werden die zuletzt geprüften Werte angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some details could not be refreshed. Last checked values may be shown."
