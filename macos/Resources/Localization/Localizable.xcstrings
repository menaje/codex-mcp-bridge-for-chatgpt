    "새 작업부터 선택한 방식으로 실행합니다. 기존 작업은 원래 실행 방식을 유지합니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 작업부터 선택한 방식으로 실행합니다. 기존 작업은 원래 실행 방식을 유지합니다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New tasks use the selected method. Existing tasks keep their original execution method."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいタスクから選択した方法で実行します。既存のタスクは元の実行方法を維持します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新任务使用所选方式执行，现有任务保留原来的执行方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新工作使用所選方式執行，現有工作保留原本的執行方式。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las nuevas tareas usan el método elegido. Las existentes conservan el método original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouvelles tâches utilisent la méthode choisie. Les tâches existantes conservent leur méthode initiale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Aufgaben verwenden die gewählte Methode. Bestehende Aufgaben behalten ihre ursprüngliche Ausführungsmethode."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Novas tarefas usam o método selecionado. As existentes mantêm o método original."
          }
        }
      }
    },
