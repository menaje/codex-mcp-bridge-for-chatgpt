            "state": "translated",
            "value": "Importar os dois valores da área de transferência"
          }
        }
      }
    },
    "클립보드에서 붙여넣기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste from Clipboard"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
