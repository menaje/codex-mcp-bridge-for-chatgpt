    "응답한 서버의 고유 ID가 저장된 서버와 다릅니다. 연결을 거부했습니다." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ID des antwortenden Servers stimmt nicht mit dem gespeicherten Server überein. Die Verbindung wurde abgelehnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The responding server ID differs from the saved server. The connection was refused."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ID del servidor que respondió no coincide con el servidor guardado. Se rechazó la conexión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’identifiant du serveur qui a répondu diffère de celui enregistré. La connexion a été refusée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
