    "settings.allowedRootsHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Projects must resolve inside one of these security ceilings. Registering a project cannot widen them."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트 실경로는 이 보안 상한 중 하나 안에 있어야 합니다. 프로젝트를 등록해도 범위는 넓어지지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトの実体パスは、このセキュリティ上限のいずれかに含まれる必要があります。登録しても範囲は広がりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目的真实路径必须位于这些安全上限之一。注册项目不会扩大范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專案的實際路徑必須位於這些安全上限之一。登錄專案不會擴大範圍。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ruta real de cada proyecto debe estar dentro de uno de estos límites de seguridad. Registrar un proyecto no los amplía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chemin réel de chaque projet doit rester dans l’une de ces limites de sécurité. Enregistrer un projet ne les élargit pas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der reale Projektpfad muss innerhalb einer dieser Sicherheitsgrenzen liegen. Ein Projekt erweitert sie nicht."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O caminho real de cada projeto deve ficar dentro de um destes limites de segurança. Registrar um projeto não os amplia."
          }
        }
      }
    },
