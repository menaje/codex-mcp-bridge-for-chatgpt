    "완료 시 자동으로 ChatGPT에 넘기기": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically Hand Off on Completion"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了時にChatGPTへ自動的に引き継ぐ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成时自动移交给 ChatGPT"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成時自動移交給 ChatGPT"
          }
        },
        "es": {
