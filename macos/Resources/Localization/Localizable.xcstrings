    "macos.skills.youAreViewingAnImmutablePastVersionToChangeItRestoreItAsANewCurrentVersionFromVersionHistory": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are viewing an immutable past version. To change it, restore it as a new current version from Version History."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "과거 불변 버전을 보고 있습니다. 내용을 바꾸려면 버전 이력에서 새 현재 버전으로 복원하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去の不変バージョンを表示しています。変更するには、バージョン履歴から新しい現行バージョンとして復元してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你正在查看不可变的历史版本。若要更改，请从版本历史中将其恢复为新的当前版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你正在檢視不可變的歷史版本。若要變更，請從版本記錄將其還原為新的目前版本。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás viendo una versión anterior inmutable. Para cambiarla, restáurala como nueva versión actual desde el historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous consultez une ancienne version immuable. Pour la modifier, restaurez-la comme nouvelle version actuelle depuis l’historique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sehen eine unveränderliche frühere Version. Stellen Sie sie im Versionsverlauf als neue aktuelle Version wieder her, um sie zu ändern."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está vendo uma versão anterior imutável. Para alterá-la, restaure-a como nova versão atual no histórico."
          }
        }
      }
    },
