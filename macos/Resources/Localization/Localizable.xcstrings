    "macos.usesaverifiedhosteventwhenavailableotherwise": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet ein verifiziertes Hostereignis, wenn es verfügbar ist; andernfalls sendet das automatisch geöffnete Dashboard die Abschlussbenachrichtigung. Übermittlungsprotokolle bleiben erhalten, wenn kein Weg verfügbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses a verified host event when available; otherwise, an automatically opened Dashboard sends the completion notice. Delivery records are retained when no route is available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un evento de host verificado cuando está disponible; de lo contrario, el panel abierto automáticamente envía el aviso de finalización. Los registros de entrega se conservan cuando no hay una ruta disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise un événement hôte vérifié lorsqu’il est disponible ; sinon, le tableau de bord ouvert automatiquement envoie l’avis de fin. Les enregistrements de livraison sont conservés lorsqu’aucune voie n’est disponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証済みのホストイベントが利用できる場合はそれを使用し、利用できない場合は自動的に開いたダッシュボードが完了通知を送信します。利用可能な経路がない場合は配信記録を保持します。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa um evento de host verificado quando disponível; caso contrário, o painel aberto automaticamente envia o aviso de conclusão. Os registros de entrega são mantidos quando não há uma rota disponível."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有已验证的主机事件时会使用它；否则，自动打开的概览卡片会发送完成通知。没有可用路径时会保留传递记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有已驗證的主機事件時會使用它；否則，自動開啟的總覽卡片會傳送完成通知。沒有可用路徑時會保留傳遞記錄。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검증된 호스트 이벤트가 있으면 이를 사용하고, 없으면 자동으로 열린 현황 카드가 완료 알림을 보냅니다. 가능한 경로가 없으면 전달 기록을 보관합니다."
          }
        }
      }
    },
