    "macos.thisaddresswasdetectedautomaticallychangeitonly": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Adresse wurde automatisch erkannt. Ändern Sie sie nur, wenn Sie eine andere private DNS- oder VPN-Adresse verwenden müssen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This address was detected automatically. Change it only when you need to use a different private DNS or VPN address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta dirección se detectó automáticamente. Cámbiala solo si necesitas usar otra dirección DNS privada o de VPN."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse a été détectée automatiquement. Modifiez-la uniquement si vous devez utiliser une autre adresse DNS privée ou VPN."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアドレスは自動検出されました。別のプライベートDNSまたはVPNアドレスを使用する必要がある場合のみ変更してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este endereço foi detectado automaticamente. Altere-o somente se precisar usar outro endereço DNS privado ou de VPN."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此地址由系统自动检测。仅在需要使用其他专用 DNS 或 VPN 地址时更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此位址由系統自動偵測。僅在需要使用其他私人 DNS 或 VPN 位址時變更。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 감지한 주소입니다. 다른 사설 DNS 또는 VPN 주소를 사용해야 할 때만 변경하세요."
          }
        }
      }
    },
    "macos.selectatleastonecombinationfortheautomatic": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie mindestens eine explizite Kombination für die Zulassungsliste der automatischen Richtlinie aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select at least one combination for the automatic policy allowlist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione al menos una combinación explícita para la lista permitida de la política automática."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez au moins une combinaison explicite dans la liste autorisée de la stratégie automatique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動ポリシーの明示的な許可リストを1つ以上選択してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione ao menos uma combinação para a lista de permissões explícita da política automática."
          }
        },
        "zh-Hans": {
