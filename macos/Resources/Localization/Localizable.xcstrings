          "stringUnit": {
            "state": "translated",
            "value": "这是每个任务默认请求的访问权限，不能超过“服务器”标签页中设置的最大访问权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是每個工作預設要求的存取權限，不能超過「伺服器」分頁中設定的最大存取權限。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es el nivel de acceso predeterminado que solicita cada tarea. No puede superar el acceso máximo definido en la pestaña Servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s’agit du niveau d’accès demandé par défaut par chaque tâche. Il ne peut pas dépasser l’accès maximal défini dans l’onglet Serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist die Standardzugriffsstufe, die jede Aufgabe anfordert. Sie kann den im Tab „Server“ festgelegten maximalen Zugriff nicht überschreiten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é o nível de acesso padrão solicitado por cada tarefa. Ele não pode exceder o acesso máximo definido na aba Servidor."
          }
        }
      }
    },
