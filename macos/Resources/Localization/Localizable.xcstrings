    "보관된 프로젝트 등록을 삭제할까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this archived project registration?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブ済みのプロジェクト登録を削除しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此已归档的项目注册？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除此已歸檔的專案註冊？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar este registro de proyecto archivado?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer cette inscription de projet archivée ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese archivierte Projektregistrierung löschen?"
          }
        },
        "pt": {
