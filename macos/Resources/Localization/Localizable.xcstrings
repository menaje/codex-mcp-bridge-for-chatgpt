    "복구된 서버 상태가 예약과 일치하지 않습니다. 서버 상태를 확인한 뒤 다시 요청해 주세요.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구된 서버 상태가 예약과 일치하지 않습니다. 서버 상태를 확인한 뒤 다시 요청해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovered server state does not match the pending request. Check the server status and submit the request again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復旧したサーバーの状態が予約内容と一致しません。サーバーの状態を確認してから再度リクエストしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复后的服务器状态与待执行请求不一致。请检查服务器状态后重新提交请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原後的伺服器狀態與待執行請求不一致。請檢查伺服器狀態後重新提交請求。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado del servidor recuperado no coincide con la solicitud pendiente. Comprueba el estado del servidor y vuelve a enviar la solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’état du serveur rétabli ne correspond pas à la demande en attente. Vérifiez l’état du serveur et envoyez à nouveau la demande."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der wiederhergestellte Serverzustand stimmt nicht mit der ausstehenden Anfrage überein. Prüfe den Serverstatus und sende die Anfrage erneut."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
