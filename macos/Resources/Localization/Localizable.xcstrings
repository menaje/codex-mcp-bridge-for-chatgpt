          }
        }
      }
    },
    "저장되지 않은 대화를 보호하고 있습니다. 해당 Agent를 아카이브해 주세요.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장되지 않은 대화를 보호하고 있습니다. 해당 Agent를 아카이브해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protecting unsaved conversations. Archive the affected Agents to continue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未保存の会話を保護しています。該当するAgentをアーカイブしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保护尚未保存的对话。请归档相关 Agent 以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保護尚未儲存的對話。請封存相關 Agent 以繼續。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se están protegiendo conversaciones sin guardar. Archiva los Agents afectados para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conversations non enregistrées sont protégées. Archivez les Agents concernés pour continuer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gespeicherte Unterhaltungen werden geschützt. Archivieren Sie die betroffenen Agents, um fortzufahren."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Protegendo conversas não salvas. Arquive os Agents afetados para continuar."
          }
        }
      }
    },
    "승인이나 답변을 기다리고 있습니다.": {
      "localizations": {
        "ko": {
          "stringUnit": {
