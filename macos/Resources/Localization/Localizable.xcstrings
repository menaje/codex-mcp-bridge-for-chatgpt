    "problem.automaticLogNotice": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bridge actions and verified results are kept here. Task success requires separate verification."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브리지가 수행한 조치와 결과를 보관합니다. 작업의 성공 여부는 별도로 검증합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブリッジの処理と検証済みの結果を保持します。作業の成功は別途検証します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处保留桥接器操作和已验证的结果。任务成功与否需另行验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處保留橋接器操作和已驗證的結果。任務成功與否需另行驗證。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí se conservan las acciones y resultados verificados del puente. El éxito de la tarea requiere verificación aparte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les actions du pont et leurs résultats vérifiés sont conservés ici. La réussite de la tâche doit être vérifiée séparément."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier bleiben Bridge-Maßnahmen und geprüfte Ergebnisse erhalten. Der Aufgabenerfolg wird separat geprüft."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aqui ficam as ações da ponte e os resultados verificados. O sucesso da tarefa requer uma verificação separada."
          }
        }
      }
    },
    "problem.historyEmpty": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No retained failures."
          }
        },
        "ko": {
