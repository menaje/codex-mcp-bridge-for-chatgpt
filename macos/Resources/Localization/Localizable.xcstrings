        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远程连接需要安全检查。请在连接设置中查看服务器和设备注册信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遠端連線需要安全檢查。請在連線設定中查看伺服器和裝置註冊資訊。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión remota requiere una comprobación de seguridad. Revisa el servidor y el registro del dispositivo en los ajustes de conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion distante nécessite une vérification de sécurité. Consultez le serveur et l’enregistrement de l’appareil dans les réglages de connexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die entfernte Verbindung benötigt eine Sicherheitsprüfung. Prüfe Server und Geräteregistrierung in den Verbindungseinstellungen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão remota precisa de uma verificação de segurança. Confira o servidor e o registro do dispositivo nos ajustes de conexão."
          }
        }
      }
    },
    "구성 요소가 호환되지 않습니다. 연결 설정에서 업데이트 또는 복구 방법을 확인해 주세요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성 요소가 호환되지 않습니다. 연결 설정에서 업데이트 또는 복구 방법을 확인해 주세요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Components are incompatible. Check connection settings for update or recovery options."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンポーネントに互換性がありません。接続設定で更新または復旧方法を確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "组件不兼容。请在连接设置中查看更新或恢复方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "元件不相容。請在連線設定中查看更新或復原方式。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los componentes no son compatibles. Consulta las opciones de actualización o recuperación en los ajustes de conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les composants sont incompatibles. Consultez les options de mise à jour ou de récupération dans les réglages de connexion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Komponenten sind nicht kompatibel. Prüfe Aktualisierungs- oder Wiederherstellungsoptionen in den Verbindungseinstellungen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os componentes são incompatíveis. Veja opções de atualização ou recuperação nos ajustes de conexão."
          }
        }
      }
    },
    "런타임 또는 프로세스 상태를 확인하지 못한 Agent가 %lld개 있습니다.": {
      "localizations": {
        "de": {
