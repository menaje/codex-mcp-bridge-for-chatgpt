        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인이 필요한 구성요소만 먼저 표시합니다. 정상 구성요소는 요약해서 보여줍니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente os componentes que precisam de atenção aparecem primeiro; os prontos ficam resumidos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先显示需要处理的组件，已就绪的组件保持摘要显示。"
