          }
        }
      }
    },
    "macos.couldnotfinishcheckingorstoppingtherelated": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die zugehörigen Prozesse konnten nicht vollständig geprüft oder beendet werden. Prüfe den Serverstatus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not finish checking or stopping the related processes. Check the server status."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la comprobación o detención de los procesos relacionados. Comprueba el estado del servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de terminer la vérification ou l’arrêt des processus associés. Vérifiez l’état du serveur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "関連プロセスの確認または終了を完了できませんでした。サーバーの状態を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관련 프로세스의 확인 또는 종료를 마치지 못했습니다. 서버 상태를 확인해 주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a verificação ou o encerramento dos processos relacionados. Verifique o estado do servidor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能完成相关进程的检查或停止。请检查服务器状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未能完成相關程序的檢查或停止。請檢查伺服器狀態。"
          }
        }
      }
    },
    "macos.componentsareincompatiblecheckconnectionsettingsforupdate": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Komponenten sind nicht kompatibel. Prüfe Aktualisierungs- oder Wiederherstellungsoptionen in den Verbindungseinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Components are incompatible. Check connection settings for update or recovery options."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los componentes no son compatibles. Consulta las opciones de actualización o recuperación en los ajustes de conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les composants sont incompatibles. Consultez les options de mise à jour ou de récupération dans les réglages de connexion."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンポーネントに互換性がありません。接続設定で更新または復旧方法を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성 요소가 호환되지 않습니다. 연결 설정에서 업데이트 또는 복구 방법을 확인해 주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os componentes são incompatíveis. Veja opções de atualização ou recuperação nos ajustes de conexão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "组件不兼容。请在连接设置中查看更新或恢复方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "元件不相容。請在連線設定中查看更新或復原方式。"
          }
        }
      }
    },
    "macos.devicecredentialsarestoredonlyinthemacos": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräteanmeldedaten werden ausschließlich im macOS-Schlüsselbund gespeichert. Serveradressen und Profile enthalten keine Geheimnisse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device credentials are stored only in the macOS Keychain. Server addresses and profiles contain no secrets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las credenciales del dispositivo solo se guardan en el Llavero de macOS. Las direcciones y los perfiles de servidor no contienen secretos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les identifiants de l’appareil sont stockés uniquement dans le Trousseau macOS. Les adresses et profils de serveur ne contiennent aucun secret."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの資格情報はmacOSキーチェーンにのみ保存されます。サーバーアドレスやプロファイルに秘密情報は含まれません。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As credenciais do dispositivo são armazenadas apenas nas Chaves do macOS. Os endereços e perfis de servidor não contêm segredos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备凭据仅存储在 macOS 钥匙串中。服务器地址和配置文件不包含任何密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置憑證僅儲存在 macOS 鑰匙串中。伺服器地址和設定檔不包含任何金鑰。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 자격 증명은 macOS Keychain에만 저장됩니다. 서버 주소나 프로필에는 비밀값이 포함되지 않습니다."
          }
        }
      }
    },
