    "서버 인증서가 페어링할 때 확인한 인증서와 다릅니다. 연결을 거부했습니다." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Serverzertifikat weicht von dem bei der Kopplung geprüften Zertifikat ab. Die Verbindung wurde abgelehnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The server certificate differs from the one verified during pairing. The connection was refused."
          }
        },
