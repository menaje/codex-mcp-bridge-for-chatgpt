        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此變更要求已用於其他操作或因刪除而失效。請使用新要求再試一次。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta solicitud de cambio se usó en otra operación o quedó invalidada por una eliminación. Inténtalo con una solicitud nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette demande de modification a été utilisée par une autre opération ou invalidée par une suppression. Réessayez avec une nouvelle demande."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Änderungsanfrage wurde von einem anderen Vorgang verwendet oder durch Löschen ungültig. Versuchen Sie es mit einer neuen Anfrage erneut."
          }
