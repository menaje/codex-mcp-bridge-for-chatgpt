    "현재 편집 내용을 버리고 최신 설정을 불러올까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard your current edits and load the latest settings?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の編集内容を破棄して最新の設定を読み込みますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放弃当前编辑并加载最新设置？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放棄目前編輯並載入最新設定？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Descartar los cambios actuales y cargar la configuración más reciente?"
          }
        },
