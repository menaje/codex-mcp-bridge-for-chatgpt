          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许远程管理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許遠端管理"
          }
        },
        "es": {
