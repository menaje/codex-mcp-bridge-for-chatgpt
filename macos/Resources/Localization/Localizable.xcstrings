    "저장된 서버가 없습니다. 아래 페어링 초대를 입력해 첫 서버를 등록하세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No servers are saved. Enter a pairing invitation below to register the first server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのサーバーはありません。下のペアリング招待を入力して最初のサーバーを登録してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已保存的服务器。请在下方输入配对邀请以注册第一台服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有已儲存的伺服器。請在下方輸入配對邀請以註冊第一臺伺服器。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay servidores guardados. Introduzca una invitación de emparejamiento a continuación para registrar el primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun serveur n’est enregistré. Saisissez une invitation de jumelage ci-dessous pour inscrire le premier serveur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sind keine Server gespeichert. Geben Sie unten eine Kopplungseinladung ein, um den ersten Server zu registrieren."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há servidores salvos. Digite abaixo um convite de pareamento para registrar o primeiro servidor."
          }
        }
      }
    },
    "저장된 서버를 이 Mac에서 삭제할까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the saved server from this Mac?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのサーバーをこのMacから削除しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从此 Mac 删除已保存的服务器？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從此 Mac 刪除已儲存的伺服器？"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar el servidor guardado de este Mac?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer de ce Mac le serveur enregistré ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherten Server von diesem Mac löschen?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir o servidor salvo deste Mac?"
          }
        }
      }
    },
    "저장됨": {
      "localizations": {
        "en": {
