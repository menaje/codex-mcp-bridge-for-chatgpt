          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay una señal de progreso reciente; se desconoce si el proceso sigue activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun signal de progression récent ; l’état du processus est inconnu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein aktuelles Fortschrittssignal; der Prozessstatus ist unbekannt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
