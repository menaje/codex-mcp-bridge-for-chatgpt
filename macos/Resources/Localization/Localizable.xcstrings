        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 실행 %d개를 중단할까요? 파일 변경사항은 되돌리지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続された%d件の実行を停止しますか？ファイルの変更は元に戻りません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
