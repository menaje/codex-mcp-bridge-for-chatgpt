    "settings.noProjects": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register a project first. Codex needs a folder where it can start work, and you may add multiple folders from different locations on this PC."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 프로젝트를 등록하세요. Codex가 작업을 시작할 폴더가 필요합니다. 이 PC의 서로 다른 위치에 있는 폴더를 여러 개 추가할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずプロジェクトを登録してください。Codex が作業を開始するフォルダーが必要です。この PC 上の異なる場所を複数追加できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先注册项目。Codex 需要一个开始工作的文件夹；你可以添加此电脑上不同位置的多个文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先登錄專案。Codex 需要一個開始工作的資料夾；你可以加入此電腦上不同位置的多個資料夾。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra primero un proyecto. Codex necesita una carpeta donde empezar a trabajar; puedes añadir varias carpetas de distintas ubicaciones de este PC."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez d’abord un projet. Codex a besoin d’un dossier où commencer ; vous pouvez ajouter plusieurs dossiers situés à différents endroits sur ce PC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrieren Sie zuerst ein Projekt. Codex benötigt einen Startordner; Sie können mehrere Ordner an verschiedenen Orten dieses PCs hinzufügen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre primeiro um projeto. O Codex precisa de uma pasta onde começar; você pode adicionar várias pastas de locais diferentes deste PC."
          }
        }
      }
    },
