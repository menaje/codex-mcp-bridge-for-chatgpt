    "설치된 앱 번들에서 로그인 항목을 찾지 못했습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The login item could not be found in the installed app bundle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みのアプリバンドルにログイン項目が見つかりませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在已安装的应用包中找不到登录项。"
