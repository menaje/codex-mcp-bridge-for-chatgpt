            "state": "translated",
            "value": "Guardar cambios automáticamente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer automatiquement les modifications"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen automatisch speichern"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar alterações automaticamente"
          }
        }
      }
    },
    "변경사항은 자동으로 저장되어 기존 ChatGPT 카드와 공유됩니다. 프로젝트 등록은 일반 설정 초기화에 포함되지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes save automatically and are shared with existing ChatGPT cards. Project registrations are not reset with general settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は自動保存され、既存のChatGPTカードと共有されます。プロジェクト登録は一般設定のリセット対象に含まれません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改会自动保存并与现有 ChatGPT 卡片共享。项目注册不会随常规设置一起重置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更改會自動儲存並與現有 ChatGPT 卡片共享。專案註冊不會隨常規設定一起重置。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se guardan automáticamente y se comparten con las tarjetas de ChatGPT existentes. Los registros de proyectos no se incluyen al restablecer la configuración general."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications sont enregistrées automatiquement et partagées avec les cartes ChatGPT existantes. Les inscriptions de projets ne sont pas réinitialisées avec les paramètres généraux."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen werden automatisch gespeichert und mit vorhandenen ChatGPT-Karten geteilt. Projektregistrierungen werden beim Zurücksetzen der allgemeinen Einstellungen nicht zurückgesetzt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações são salvas automaticamente e compartilhadas com os cartões existentes do ChatGPT. Os registros de projetos não são redefinidos com as configurações gerais."
          }
        }
      }
    },
