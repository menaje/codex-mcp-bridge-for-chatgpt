        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 카탈로그를 사용할 수 없습니다. 백엔드 연결을 복구한 뒤 모델 조회를 다시 시도하세요."
          }
        },
        "ja": {
          "stringUnit": {
