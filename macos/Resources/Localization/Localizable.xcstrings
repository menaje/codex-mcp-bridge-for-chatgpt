    "기존 private .env가 유효하면 그대로 사용합니다. Keychain은 사용하지 않습니다.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An existing valid private .env is kept as is. Keychain is not used."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のprivate .envが有効な場合はそのまま使用します。キーチェーンは使用しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果现有的私有 .env 有效，将保持原样使用。不使用钥匙串。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果現有的私有 .env 有效，將保持原樣使用。不使用鑰匙串。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el archivo .env privado existente es válido, se conserva sin cambios. No se usa el Llavero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le fichier .env privé existant est valide, il est conservé tel quel. Le Trousseau n’est pas utilisé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine vorhandene gültige private .env wird unverändert verwendet. Der Schlüsselbund wird nicht verwendet."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o arquivo .env privado existente for válido, ele será mantido sem alterações. As Chaves não são usadas."
          }
        }
      }
    },
