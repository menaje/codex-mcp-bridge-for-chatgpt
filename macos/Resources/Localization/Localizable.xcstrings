          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró el elemento de inicio de sesión en el paquete de la app instalada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’élément d’ouverture de session est introuvable dans le paquet de l’app installée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Anmeldeobjekt wurde im installierten App-Bundle nicht gefunden."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível encontrar o item de início de sessão no pacote do aplicativo instalado."
          }
