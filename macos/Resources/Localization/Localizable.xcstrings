        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking background process status."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドの実行状態を確認しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
