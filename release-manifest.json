{
  "$schema": "./release-manifest.schema.json",
  "manifestVersion": 2,
  "product": {
    "displayName": "Codex MCP Bridge for ChatGPT",
    "description": "A policy-enforcing Streamable HTTP MCP bridge from ChatGPT to local Codex.",
    "runtimeName": "codex-mcp-bridge"
  },
  "package": {
    "name": "codex-mcp-bridge-for-chatgpt",
    "binaryName": "codex-mcp-bridge",
    "license": "MIT",
    "files": [
      "dist",
      "README.md",
      "LICENSE",
      "UPSTREAM.md",
      "docs",
      "scripts/build-fingerprint.mjs",
      "scripts/child-shutdown.mjs",
      "scripts/http-health.mjs",
      "scripts/launcher-options.mjs",
      "scripts/managed-file.mjs",
      "scripts/managed-file.d.mts",
      "scripts/runtime-env.mjs",
      "scripts/runtime-lock.mjs",
      "scripts/runtime-status.mjs",
      "scripts/runtime-status.d.mts",
      "scripts/start-codex-mcp-bridge.mjs",
      "scripts/tunnel-profile.mjs",
      ".codex-plugin",
      ".app.json",
      "release-manifest.json",
      "release-manifest.schema.json"
    ],
    "keywords": [
      "codex",
      "chatgpt",
      "mcp",
      "model-context-protocol",
      "bridge"
    ]
  },
  "toolchain": {
    "node": "22",
    "npm": "10.9.3",
    "codexCli": "0.145.0"
  },
  "repository": {
    "provider": "github",
    "owner": "menaje",
    "name": "codex-mcp-bridge-for-chatgpt"
  },
  "plugin": {
    "name": "codex-mcp-bridge",
    "displayName": "Codex MCP Bridge for ChatGPT",
    "shortDescription": "Connect ChatGPT to your local Codex",
    "longDescription": "Run and monitor local Codex tasks from ChatGPT through a policy-enforcing MCP bridge. MCP Server is the stable default. Optional App Server integration is experimental and unsupported for production; use it only for personal or development work with monitoring and rollback ready.",
    "developerName": "menaje",
    "category": "Developer Tools",
    "capabilities": [
      "Run and continue local Codex tasks",
      "Monitor agents, activities, and jobs",
      "Choose models and reasoning effort",
      "Control working folders and access policy"
    ],
    "defaultPrompt": [
      "Ask local Codex to inspect this project and explain how it works.",
      "Use local Codex to implement this change and track the activity.",
      "Show the status of my active Codex agents and activities."
    ],
    "app": {
      "name": "codex-mcp-bridge",
      "id": "plugin_asdk_app_6a86b6dc2fd4819192d54ec3fb27e5b0"
    }
  },
  "uiResources": {
    "strategy": "content-hash",
    "hashAlgorithm": "sha256",
    "hashLength": 12,
    "minimumContractGeneration": {
      "settings": 9,
      "activity": 12,
      "dashboard": 6
    },
    "resources": [
      "settings",
      "activity",
      "dashboard"
    ]
  },
  "release": {
    "version": "0.3.0",
    "tagPrefix": "v",
    "channel": "stable",
    "generateNotes": true,
    "targets": {
      "macos": {
        "architecture": "arm64",
        "format": "dmg",
        "minimumVersion": "13.0",
        "signing": "ad-hoc",
        "notarization": "none"
      },
      "windows": {
        "architecture": "x64",
        "format": "zip",
        "transport": "http",
        "runtime": "node"
      }
    },
    "assets": [
      "npm-tarball",
      "npm-sha256",
      "skills-archive",
      "macos-app",
      "windows-server",
      "release-checksums"
    ]
  }
}
