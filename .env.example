# Copy this file to ~/.config/codex-mcp-bridge/.env, replace both values below,
# and run: chmod 600 ~/.config/codex-mcp-bridge/.env
# Keep the runtime file outside every registered project folder.
# CONTROL_PLANE_API_KEY=sk-replace-with-runtime-key
# CONTROL_PLANE_TUNNEL_ID=tunnel_replace_with_32_lowercase_chars

# Direct-server defaults. The bundled local/secure launcher pins loopback and
# uses port 8876 unless --port or CODEX_MCP_BRIDGE_PORT overrides it.
# CODEX_MCP_BRIDGE_HOST=127.0.0.1
# CODEX_MCP_BRIDGE_PORT=8765
# CODEX_MCP_BRIDGE_ALLOWED_HOSTS=127.0.0.1,localhost
# Bundled secure launcher candidate: http (default) or stdio.
# CODEX_MCP_BRIDGE_TUNNEL_TRANSPORT=stdio
# Streamable HTTP remains stateless by default. Experimental stateful sessions
# are process-local, keep bounded event replay, reclaim incomplete handshakes
# after 10 seconds, and require client reinitialization after a bridge restart.
# CODEX_MCP_BRIDGE_MCP_TRANSPORT_MODE=stateful
# CODEX_MCP_BRIDGE_MCP_SESSION_IDLE_TTL_MS=1800000
# CODEX_MCP_BRIDGE_MAX_MCP_SESSIONS=64
# App Server admission requires the exact CLI version pinned in release-manifest.json.
# CODEX_MCP_BRIDGE_CODEX=codex
# Project folders are registered in the Settings card after startup.
CODEX_MCP_BRIDGE_DEFAULT_SANDBOX=read-only
# User-facing strategy seed: read-only, adaptive, or always-full.
CODEX_MCP_BRIDGE_DEFAULT_ACCESS_STRATEGY=adaptive
# Opt in separately; the default remains read-only even when these are enabled.
# CODEX_MCP_BRIDGE_ALLOW_WRITE=1
# CODEX_MCP_BRIDGE_ALLOW_DANGER_FULL_ACCESS=1
# Supported values: untrusted, on-request, never.
CODEX_MCP_BRIDGE_APPROVAL_POLICY=on-request
# Optional immutable ceiling applied before user policy (JSON exact selections).
# CODEX_MCP_BRIDGE_MODEL_SELECTION_CEILING=[{"model":"gpt-5.6-sol","reasoningEffort":"max"},{"model":"gpt-5.6-terra","reasoningEffort":"high"}]
CODEX_MCP_BRIDGE_MODEL_CATALOG_CACHE_TTL_MS=600000
CODEX_MCP_BRIDGE_MODEL_CATALOG_TIMEOUT_MS=30000
# CODEX_MCP_BRIDGE_MODEL_CATALOG_STATE_FILE=/absolute/path/to/private/models.json
# Primary transactional store for settings, sessions, jobs, and bounded results.
# CODEX_MCP_BRIDGE_STATE_DATABASE_FILE=/absolute/path/to/private/state.sqlite
# The following three JSON paths are read once only for legacy migration.
# CODEX_MCP_BRIDGE_SETTINGS_STATE_FILE=/absolute/path/to/private/settings.json
# CODEX_MCP_BRIDGE_SESSION_STATE_FILE=/absolute/path/to/private/sessions.json
# CODEX_MCP_BRIDGE_JOB_STATE_FILE=/absolute/path/to/private/jobs.json
CODEX_MCP_BRIDGE_MAX_CONCURRENT_JOBS=100
CODEX_MCP_BRIDGE_UPSTREAM_POOL_SIZE=4
# New threads use the stable MCP backend by default. app-server is experimental.
CODEX_MCP_BRIDGE_DEFAULT_BACKEND=mcp-server
CODEX_MCP_BRIDGE_MAX_PROMPT_CHARS=50000
# Codex task execution is unlimited-only. There is intentionally no task-timeout setting.
CODEX_MCP_BRIDGE_JOB_TTL_MS=21600000
CODEX_MCP_BRIDGE_JOB_STALE_AFTER_MS=600000
CODEX_MCP_BRIDGE_MAX_RETAINED_JOBS=100
CODEX_MCP_BRIDGE_MAX_JOB_RESULT_BYTES=1048576

# Required only when running the HTTP endpoint directly without Secure MCP Tunnel.
# CODEX_MCP_BRIDGE_TOKEN=replace-with-a-long-random-value
# CODEX_MCP_BRIDGE_NO_AUTH=1

# Enable only for a deliberate write session.
# CODEX_MCP_BRIDGE_ALLOW_WRITE=1
# CODEX_MCP_BRIDGE_DEFAULT_SANDBOX=workspace-write
