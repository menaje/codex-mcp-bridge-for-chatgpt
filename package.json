{
  "name": "codex-mcp-bridge-for-chatgpt",
  "version": "0.3.0",
  "packageManager": "npm@10.9.3",
  "description": "A policy-enforcing Streamable HTTP MCP bridge from ChatGPT to local Codex.",
  "type": "module",
  "bin": {
    "codex-mcp-bridge": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "UPSTREAM.md",
    "docs",
    "release-manifest.json",
    "release-manifest.schema.json"
  ],
  "scripts": {
    "release:check": "node scripts/release-manifest.mjs check",
    "release:sync": "node scripts/release-manifest.mjs sync",
    "release:version": "node scripts/release-manifest.mjs version",
    "build": "npm run release:check && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node scripts/write-build-info.mjs",
    "bridge:local": "node scripts/start-codex-mcp-bridge.mjs --mode local",
    "bridge:secure": "node scripts/start-codex-mcp-bridge.mjs --mode secure",
    "bridge:secure:keychain": "zsh scripts/start-secure-from-keychain.sh",
    "bridge:secure:write:keychain": "zsh scripts/start-secure-from-keychain.sh --write",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "check": "npm run build && npm run test"
  },
  "keywords": [
    "codex",
    "chatgpt",
    "mcp",
    "model-context-protocol",
    "bridge"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/menaje/codex-mcp-bridge-for-chatgpt.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.3",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.12.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/menaje/codex-mcp-bridge-for-chatgpt#readme",
  "bugs": {
    "url": "https://github.com/menaje/codex-mcp-bridge-for-chatgpt/issues"
  }
}
